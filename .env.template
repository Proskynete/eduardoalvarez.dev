# .env.template

# ===================================
# Variables Públicas (Client-side)
# ===================================
# Estas variables serán incluidas en el bundle del cliente
# Prefijo PUBLIC_ es obligatorio

# Algolia Search (Solo lectura)
PUBLIC_ALGOLIA_APPLICATION_ID=your_application_id
PUBLIC_ALGOLIA_SEARCH_API_KEY=your_search_only_api_key
PUBLIC_ALGOLIA_INDEX_NAME=your_index_name

# Giscus Comments
PUBLIC_GISCUS_REPO=owner/repo
PUBLIC_GISCUS_REPO_ID=your_repo_id
PUBLIC_GISCUS_CATEGORY_ID=your_category_id

# Cloudflare Turnstile (formulario del newsletter). Estas son las claves de
# prueba de Cloudflare, que siempre aprueban; en Vercel van las del sitio real.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sentry (observabilidad) — OPCIONAL. Sin DSN, Sentry queda inactivo.
# Configurar SOLO en el entorno de Producción de Vercel.
PUBLIC_SENTRY_DSN=

# ===================================
# Variables Privadas (Server-side)
# ===================================
# Estas variables NUNCA se incluyen en el bundle del cliente
# Se usan solo en tiempo de build y en API routes

# Algolia Admin (Para indexar en build time)
ALGOLIA_ADMIN_API_KEY=your_admin_api_key

# Newsletter: las altas se reenvían a blog-content-manager, que envía con Resend
NEWSLETTER_API_URL=https://url-de-blog-content-manager
# El mismo valor que NEWSLETTER_SUBSCRIBE_SECRET en blog-content-manager
NEWSLETTER_SUBSCRIBE_SECRET=your_shared_secret

# Cloudflare Turnstile: clave secreta de prueba, pareja de la pública de arriba
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sentry (observabilidad) — OPCIONALES. DSN del servidor + token para subir
# source maps en el build. Configurar SOLO en Producción (Vercel).
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ===================================
# Notas de Seguridad
# ===================================
# - Nunca commitear este archivo con valores reales
# - Las variables PUBLIC_ son visibles en el cliente
# - Las variables sin PUBLIC_ son solo server-side
# - Obtén las keys de Algolia en: https://www.algolia.com/account/api-keys
# - Obtén los IDs de Giscus en: https://giscus.app/

# ===================================
# Validación de Variables
# ===================================
# Las variables de entorno se validan automáticamente en startup usando Zod.
# Si falta alguna variable requerida, el build fallará inmediatamente (fail-fast).
#
# Para desarrollo local sin todas las variables configuradas:
# SKIP_ENV_VALIDATION=true npm run dev
#
# IMPORTANTE: En producción NUNCA uses SKIP_ENV_VALIDATION=true
#
# La validación se define en: src/utils/env.ts
# La validación se ejecuta en: astro.config.mjs (startup)
