---
import { themeScript } from "@eduardoalvarez/arrecife/theme";
import { dark } from "@eduardoalvarez/arrecife/tokens";
import settings from "../../../settings";
import appleStartup from "../../../settings/apple-startup-images.json";
import { brandAssets } from "../../../settings/brand-assets";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  slug?: string;
  keywords?: string[];
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleAuthor?: string;
  articleTags?: string[];
  schema?: Record<string, unknown>;
  /** Pages that exist for the app, not for search: the offline fallback. */
  noindex?: boolean;
}

const MAX_TITLE_LENGTH = 60;
const candidateTitle = Astro.props.title ? `${Astro.props.title} | ${settings.title}` : settings.title;
const title = Astro.props.title && candidateTitle.length > MAX_TITLE_LENGTH ? Astro.props.title : candidateTitle;
const rawDescription = Astro.props.description || settings.description;
const description = rawDescription.slice(0, 160);
// Crawlers need an absolute URL; article frontmatter stores a site-relative path.
const isDefaultImage = !Astro.props.image;
const image = new URL(Astro.props.image ?? brandAssets.ogDefault, Astro.site).toString();
const imageAlt = isDefaultImage ? `${settings.title} — Technical Lead · Spec-Driven Development` : title;
// Without the trailing slash, like the sitemap, the RSS feed and the JSON-LD:
// both forms answer 200, so the canonical has to pick one.
const canonicalPath = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : "/";
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogType = Astro.props.ogType ?? "website";
const keywords = Astro.props.keywords?.join(", ") ?? settings.keywords;
const { articlePublishedTime, articleAuthor, articleTags, schema, noindex } = Astro.props;

---

<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Icons — the fin. See BRAND.md §2. The SVG wins where supported; the PNG
       files and the .ico are the fallback for older browsers and crawlers. -->
  <link rel="icon" href={brandAssets.faviconSvg} type="image/svg+xml" />
  <link rel="icon" href={brandAssets.favicon32} type="image/png" sizes="32x32" />
  <link rel="icon" href={brandAssets.favicon16} type="image/png" sizes="16x16" />
  <link rel="shortcut icon" href={brandAssets.faviconIco} sizes="16x16 32x32 48x48" />
  <link rel="apple-touch-icon" sizes="180x180" href={brandAssets.appleTouchIcon} />
  <!-- Written here and not by astro-webmanifest: the plugin only reaches the
       HTML prerendered at build time, and the articles render on demand. -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <!-- iOS launch screens, one per device (the media query has to match exactly).
       Without them the installed app opens on a blank screen. Generated by
       `npm run brand:icons` from src/settings/apple-startup-images.json. -->
  {
    appleStartup.devices.map(({ width, height, ratio }) => (
      <link
        rel="apple-touch-startup-image"
        href={`/images/manifest/startup/apple-splash-${width * ratio}x${height * ratio}.png`}
        media={`(device-width: ${width}px) and (device-height: ${height}px) and (-webkit-device-pixel-ratio: ${ratio}) and (orientation: portrait)`}
      />
    ))
  }
  <meta name="generator" content={Astro.generator} />

  <link rel="canonical" href={canonicalURL} />

  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />

  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

  <meta name="keywords" content={keywords} />
  <meta name="author" content={settings.author.name} />
  <meta name="copyright" content={settings.author.name} />
  <meta name="application-name" content="Eduardo Álvarez — Technical Lead" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={settings.title} />
  <meta name="format-detection" content="telephone=no" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content={dark.background} />
  <meta name="image" content={image} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={settings.title} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:alt" content={imageAlt} />
  {
    isDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )
  }

  {
    ogType === "article" && (
      <>
        {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
        {articleAuthor && <meta property="article:author" content={articleAuthor} />}
        {articleTags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )
  }

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@proskynete" />
  <meta name="twitter:creator" content="@proskynete" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content={imageAlt} />

  {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {/*
    The theme, before the first paint. 0.6.0 made the base mode declarable, which
    is what kept this project on a hand-written copy: the library used to follow
    `prefers-color-scheme`, and dark is this brand's primary mode, not a
    preference to be asked about.
  */}
  <script is:inline set:html={themeScript({ base: "dark" })} />
</head>

<script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-YP2WF7DHFM" is:inline></script>

<script type="text/partytown" is:inline>
  window.dataLayer = window.dataLayer || [];
  // Asignar a window.gtag (no una función local) para que Partytown pueda
  // reenviar eventos custom del hilo principal vía `forward: ["gtag"]`.
  window.gtag = function gtag() {
    dataLayer.push(arguments);
  };
  gtag("js", new Date());

  gtag("config", "G-YP2WF7DHFM");
</script>
