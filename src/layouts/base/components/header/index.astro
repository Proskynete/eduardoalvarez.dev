---
import pkg from "../../../../../package.json";
import SiteNav from "./site-nav";

interface Props {
  algolia?: {
    ALGOLIA_APPLICATION_ID?: string;
    ALGOLIA_INDEX_NAME?: string;
    ALGOLIA_SEARCH_API_KEY?: string;
  };
}

const { algolia } = Astro.props;
---

{/*
  One island for the whole bar instead of two.

  The header used to be an `.astro` shell with a `client:load` navigation and a
  `client:visible` drawer inside it. `Nav` takes the brand and the actions as
  slots, and the search state has to be shared between the items and the field,
  so the composition moved into `site-nav.tsx` and the shell went with it.
*/}
<SiteNav client:load pathname={Astro.url.pathname} version={pkg.version} algolia={algolia} />
