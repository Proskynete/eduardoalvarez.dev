---
import { buttonVariants } from "@eduardoalvarez/arrecife";
import { PUBLIC_GA_ID } from "astro:env/client";

import SiteFooter from "./site-footer";

// Same condition as components/analytics: the link only exists when the panel does.
const analyticsEnabled = import.meta.env.PROD && Boolean(PUBLIC_GA_ID);
---

<SiteFooter />

{
  analyticsEnabled && (
    <div class="pt-step-sm flex justify-end">
      {/* Opens the cookie preferences panel (components/analytics/cookie-preferences.tsx). */}
      <button type="button" data-cookie-preferences class={buttonVariants({ variant: "tertiary", size: "sm" })}>
        ./cookies
      </button>
    </div>
  )
}
