---
import { Footer, FooterLink } from "@eduardoalvarez/arrecife";

import BrandFin from "../../../../components/brand-fin/index.astro";
import settings from "../../../../settings";

/**
 * The footer is the library's now. It brings the top hairline, the width cap
 * and the CLI signature — `$ cd ~/eduardoalvarez.dev/<year>` — which this file
 * used to spell out, domain included.
 *
 * Text links rather than the icon row: `social` renders icons, and this site's
 * voice is mono text. The library supports both, and `children` is the text one.
 *
 * The brand row (fin plus wordmark) goes through `children` as well, because the
 * component has no slot for it. It wraps onto its own line at this size, so the
 * two-row reading survives — but it is a gap in the component, logged in
 * ARRECIFE-BACKLOG.md rather than worked around silently.
 */
const links = [
  ...settings.social_network.filter((s) => s.show).map((s) => ({ name: s.name.toLowerCase(), href: s.link })),
  { name: "rss", href: "/rss.xml" },
];
---

<Footer id="site-footer" className="mt-20">
  <div class="gap-step-sm flex w-full items-center">
    <BrandFin class="h-6 w-auto flex-none" />
    <span class="text-ui font-display font-bold text-text-primary">Eduardo Álvarez</span>
  </div>

  {
    links.map(({ name, href }) => (
      <FooterLink
        href={href}
        target={href.startsWith("http") ? "_blank" : undefined}
        rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
      >
        {name}
      </FooterLink>
    ))
  }
</Footer>
