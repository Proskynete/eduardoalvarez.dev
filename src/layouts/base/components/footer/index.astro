---
import BrandFin from "../../../../components/brand-fin/index.astro";
import settings from "../../../../settings";

const currentYear = new Date().getFullYear();

/**
 * Pie del sistema de identidad v1.
 *
 * El sistema usa enlaces de TEXTO en mono, no iconos: la fila de iconos
 * anterior no pertenecía a esta voz. Estructura de dos filas —
 * aleta + nombre arriba, enlaces y prompt abajo.
 */
const enlaces = [
  ...settings.social_network.filter((s) => s.show).map((s) => ({ nombre: s.name.toLowerCase(), href: s.link })),
  { nombre: "rss", href: "/rss.xml" },
];
---

<footer id="site-footer" class="mt-20 border-t border-surface-border pt-10 pb-12">
  <div class="flex items-center gap-3">
    <BrandFin class="h-6 w-auto flex-none" />
    <span class="font-display text-[15px] font-bold text-text-primary">Eduardo Álvarez</span>
  </div>

  <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <nav aria-label="Enlaces y redes" class="flex flex-wrap gap-5 font-mono text-[12.5px] text-text-muted">
      {
        enlaces.map(({ nombre, href }) => (
          <a
            href={href}
            target={href.startsWith("http") ? "_blank" : undefined}
            rel={href.startsWith("http") ? "noopener noreferrer" : undefined}
            class="transition-colors duration-200"
          >
            {nombre}
          </a>
        ))
      }
    </nav>

    <p class="font-mono text-[13px] text-text-muted">
      <span class="simbolo">$</span> cd ~/eduardoalvarez.dev/{currentYear}
    </p>
  </div>
</footer>
