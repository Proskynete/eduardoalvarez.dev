---
import { CategoryBadge, Text, social } from "@eduardoalvarez/arrecife";

import type { CategoryAllowed } from "../../../interfaces";
import { CategoryMap } from "../../../utils/categories";
import { githubArticlePath } from "../../../utils/articles";
import { prettyDate } from "../../../utils/date";

const { content } = Astro.props;
---

<header class="pb-step-lg border-hairline border-b">
  {/*
    `CategoryBadge`, which is the component the system publishes for exactly
    this. It was `badgeVariants({ variant: "warm" })` with `uppercase
    tracking-wider` bolted on: the sand tint was right, but the shape was the
    status badge's and the transform was invented here. The article cards on
    /articles already draw their category with `CategoryBadge`, so the same tag
    had two shapes depending on where you read it.
  */}
  {
    content.categories && content.categories.length > 0 && (
      <div class="gap-step-xs mb-step-md flex flex-wrap">
        {content.categories.map((category: CategoryAllowed) => (
          <CategoryBadge>{CategoryMap.get(category) ?? category}</CategoryBadge>
        ))}
      </div>
    )
  }

  <!-- Title -->
  <h1 id="article-title" class="text-text-primary mb-step-md">
    {content.title}
  </h1>

  <!-- Meta -->
  <div class="gap-x-step-md gap-y-step-xs flex flex-wrap items-center">
    <time datetime={content.date}>
      <Text variant="meta" tone="muted" as="span">{prettyDate(content.date)}</Text>
    </time>
    <Text variant="meta" tone="muted" as="span" aria-hidden="true">·</Text>
    {/*
      `social.GitHub` instead of the copy in `assets/icons`: the same mark was
      drawn twice in this repo, and the library's is the one the footer and the
      share buttons already use.
    */}
    <a
      class="gap-step-xs text-meta font-mono text-accent transition-standard focus-ring inline-flex items-center hover:underline"
      href={githubArticlePath(content.slug)}
      target="_blank"
      rel="noopener noreferrer"
    >
      ¿Ves una errata? Edita en GitHub
      <social.GitHub />
    </a>
  </div>
</header>
