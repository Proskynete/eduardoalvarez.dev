---
import { Badge, Card, TableOfContents, Text, buttonVariants } from "@eduardoalvarez/arrecife";
import { Icon } from "@eduardoalvarez/arrecife/icons";
import { CaretRight, LinkedinLogo, XLogo } from "@phosphor-icons/react";

import TextLink from "../../../components/text-link/index.astro";
import type { TagsAllowed } from "../../../interfaces";
import { TagMap } from "../../../utils/categories";

const { content, timeToRead, twitterShare, linkedInShare } = Astro.props;
const prettyTimeToReadText = timeToRead <= 1 ? "minuto" : "minutos";

/**
 * How many tags fit in the sidebar.
 *
 * Articles carry between 1 and 10, averaging 8 on the long ones, and at that
 * count the list stops signalling the subject and becomes noise — nobody reads
 * ten labels. Four place the article and fit on two lines. The rest stay in the
 * frontmatter, which is what search indexes.
 */
const MAX_TAGS = 4;
const tags: TagsAllowed[] = (content.tags ?? []).slice(0, MAX_TAGS);
const remaining = (content.tags?.length ?? 0) - tags.length;

const sections = (content.sections ?? []).map((section: { anchor: string; title: string }) => ({
  href: `#${section.anchor}`,
  label: section.title,
}));
---

{/*
  The four panels are `Card` now. They were `bg-surface rounded-xl p-4 border
  border-border` written out four times: the same surface the system publishes as
  one token, with `border` — the token for delimiting a control — where a card
  wants `hairline`, and `rounded-xl` where the scale says `rounded-card`.

  `p-step-md` and not the card's own `p-step-lg`: this rail is 220px wide and 26
  of padding on each side leaves the tags nowhere to sit.
*/}
<aside aria-label="Información del artículo" class="xl:sticky xl:top-24 xl:self-start mb-10 xl:mb-0">
  <div class="gap-step-sm flex flex-col">
    <Card className="p-step-md">
      <Text variant="eyebrow" tone="muted" as="p" className="mb-step-xs">Lectura</Text>
      <Text variant="ui" as="p" className="font-medium">{timeToRead} {prettyTimeToReadText} aprox.</Text>
    </Card>

    {/*
      The categories card is gone: the article header already shows them a few
      centimetres above the title, and repeating them here added nothing.
    */}
    {
      tags.length > 0 && (
        <Card className="p-step-md">
          <Text variant="eyebrow" tone="muted" as="p" className="mb-step-xs">Tags</Text>
          <div class="gap-step-xs flex flex-wrap">
            {tags.map((tag) => (
              <Badge variant="neutral">{TagMap.get(tag) ?? tag}</Badge>
            ))}
            {remaining > 0 && (
              <Text variant="chip" tone="muted" as="span" className="self-center">
                +{remaining}
              </Text>
            )}
          </div>
        </Card>
      )
    }

    {
      sections.length > 0 && (
        <details class="xl:hidden bg-surface rounded-card border-hairline overflow-hidden border">
          <summary class="px-step-md py-step-sm text-eyebrow font-mono uppercase text-text-muted hover:text-text-primary transition-standard flex cursor-pointer select-none list-none items-center justify-between">
            Secciones del artículo
            <span class="text-accent"><Icon as={CaretRight} /></span>
          </summary>
          <TableOfContents title="En esta página" items={sections} className="px-step-md pb-step-md" />
        </details>
      )
    }

    {/*
      `TableOfContents` renders the heading. There used to be a hand-written
      `<p>` above it with the same words, so "En esta página" appeared twice.
    */}
    {
      sections.length > 0 && (
        <Card className="hidden overflow-hidden p-step-md xl:block">
          <TableOfContents title="En esta página" items={sections} />
        </Card>
      )
    }

    <Card className="p-step-md">
      <Text variant="eyebrow" tone="muted" as="p" className="mb-step-sm">Compartir</Text>
      <div class="gap-step-xs flex">
        {/*
          Phosphor's marks, drawn through the library's `Icon`: the same two the
          footer and the episode page carry, at the same weight and at 1em.
          Rendered on the server with no client directive, so the sidebar still
          ships no JavaScript.
        */}
        <a
          href={twitterShare}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class={`${buttonVariants({ variant: "secondary", size: "md" })} flex-1`}
          aria-label="Compartir en X"
        >
          <Icon as={XLogo} />
        </a>
        <a
          href={linkedInShare}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class={`${buttonVariants({ variant: "secondary", size: "md" })} flex-1`}
          aria-label="Compartir en LinkedIn"
        >
          <Icon as={LinkedinLogo} />
        </a>
      </div>
    </Card>

    <TextLink href="/articles" back>./artículos</TextLink>
  </div>
</aside>
