---
import "../../assets/styles/article.css";

import Layout from "../base/index.astro";
import Head from "./components/head.astro";
import Aside from "./components/aside.astro";
import AudioPlayer from "../../components/audio-player/index";
import { GiscusWrapper } from "./components/giscus";
import { calculateReadingTime } from "../../utils/reading-time";
import type { Props as BaseHeadProps } from "../base/components/head.astro";
import type { Article } from "../../interfaces";
import settings from "../../settings";

type Props = {
  content: Article;
};

const { content } = Astro.props;

const timeToRead = calculateReadingTime(await Astro.slots.render("default"));

const tags = content.categories.map((tag) => tag.replaceAll(/(-)/g, "")).join(",");
const twitterShare = `https://twitter.com/intent/tweet?text=${content.title}&url=https://www.eduardoalvarez.dev/articles/${content.slug}&via=proskynete&hashtags=${tags}`;
const linkedInShare = `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`https://www.eduardoalvarez.dev/articles/${content.slug}`)}&title=${encodeURIComponent(content.title)}`;

const articleKeywords = content.keywords ?? content.categories;

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: content.title,
  description: content.seo_description.slice(0, 160),
  datePublished: content.date,
  ...(content.date_modified ? { dateModified: content.date_modified } : {}),
  url: `${settings.url}/articles/${content.slug}`,
  image: content.seo_image,
  author: {
    "@type": "Person",
    name: settings.author.name,
    url: settings.url,
  },
  keywords: articleKeywords,
};

const seo: BaseHeadProps = {
  title: content.title,
  description: content.seo_description,
  image: content.seo_image,
  slug: `/articles/${content.slug}`,
  keywords: content.keywords,
  ogType: "article",
  articlePublishedTime: content.date,
  articleAuthor: settings.author.name,
  articleTags: content.categories,
  schema,
};
---

<script>
  import { trackEvent } from "../../utils/analytics";

  /**
   * Resalta en el índice la sección en la que está el lector.
   *
   * Marca el ÚLTIMO encabezado que ya pasó la línea de lectura, no el que esté
   * dentro de una franja. Con IntersectionObserver y una franja estrecha, una
   * sección larga deja la franja vacía y el resaltado desaparece a media
   * lectura — que es justo cuando más sirve.
   */
  function initIndice() {
    const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="En esta página"] a[href^="#"]'));
    if (!enlaces.length) return;

      /*
       * Deduplicado por ancla: la página monta DOS tablas de contenidos —una
       * plegable para pantallas estrechas y una tarjeta para anchas— y ambas
       * enlazan a los mismos encabezados. Sin deduplicar, cada ancla aparece dos
       * veces y el `break` de abajo corta dentro de la primera copia, así que el
       * resaltado caía siempre en la tabla oculta y la visible no se marcaba.
       */
      const vistos = new Set<string>();
      const pares = enlaces
        .map((a) => ({ hash: a.hash, el: document.getElementById(decodeURIComponent(a.hash.slice(1))) }))
        .filter((x): x is { hash: string; el: HTMLElement } => {
          if (!x.el || vistos.has(x.hash)) return false;
          vistos.add(x.hash);
          return true;
        });
      if (!pares.length) return;

      const LINEA = 140; // px desde arriba: bajo la nav pegajosa de 64px
      let ultimo: string | null = null;

      const marcar = () => {
        let activo = pares[0];
        for (const par of pares) {
          if (par.el.getBoundingClientRect().top <= LINEA) activo = par;
          else break;
        }
        if (activo.hash === ultimo) return; // no tocar el DOM si no cambió
        // Se marca en TODAS las tablas: cuál está visible depende del ancho, y
        // el script no tiene por qué saberlo.
        enlaces.forEach((a) => {
          if (a.hash === activo.hash) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        });
        ultimo = activo.hash;
      };

    let pendiente = false;
    const alHacerScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pendiente = false;
        marcar();
      });
    };

    marcar();
    window.addEventListener("scroll", alHacerScroll, { passive: true });
    window.addEventListener("resize", alHacerScroll, { passive: true });
  }

  function initCodeBlocks() {
    const pres = document.querySelectorAll<HTMLElement>("#article-body pre[data-language]");
    pres.forEach((pre) => {
      if (pre.closest(".code-block-wrapper")) return;

      const lang = pre.getAttribute("data-language") ?? "";

      const wrapper = document.createElement("div");
      wrapper.className = "code-block-wrapper";

      const header = document.createElement("div");
      header.className = "code-block-header";

      // The fin as the block's mark. Decorative: the language label beside it
      // already names the content.
      const fin = document.createElement("img");
      fin.className = "code-block-fin";
      fin.src = "/brand/fin-foam.png";
      fin.alt = "";
      fin.setAttribute("aria-hidden", "true");
      fin.width = 147;
      fin.height = 111;

      const label = document.createElement("span");
      label.className = "code-language-label";
      label.textContent = lang;

      const copyBtn = document.createElement("button");
      copyBtn.className = "code-copy-btn";
      copyBtn.textContent = "Copiar";
      copyBtn.addEventListener("click", () => {
        const code = pre.querySelector("code");
        const text = code ? code.innerText : pre.innerText;
        navigator.clipboard.writeText(text).then(() => {
          copyBtn.textContent = "Copiado";
          copyBtn.classList.add("copied");
          setTimeout(() => {
            copyBtn.textContent = "Copiar";
            copyBtn.classList.remove("copied");
          }, 2000);
        });
      });

      header.appendChild(fin);
      header.appendChild(label);
      header.appendChild(copyBtn);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.appendChild(header);
      wrapper.appendChild(pre);
    });
  }

  function initSmoothScroll() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="En esta página"] a[href^="#"]');
    tocLinks.forEach((link) => {
      link.addEventListener("click", (e) => {
        const href = link.getAttribute("href");
        if (!href) return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.pushState(null, "", href);
      });
    });
  }

  // Mide lectura real: dispara una vez al superar el 90% del scroll del artículo.
  function initArticleReadTracking() {
    const article = document.querySelector<HTMLElement>("[data-article-slug]");
    const slug = article?.dataset.articleSlug;
    if (!slug) return;
    let tracked = false;
    const onScroll = () => {
      if (tracked) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      if ((window.scrollY / scrollable) * 100 >= 90) {
        tracked = true;
        trackEvent("article_read", { slug });
        window.removeEventListener("scroll", onScroll);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  initIndice();
  document.addEventListener("astro:page-load", initIndice);
  document.addEventListener("astro:page-load", initCodeBlocks);
  document.addEventListener("astro:page-load", initSmoothScroll);
  document.addEventListener("astro:page-load", initArticleReadTracking);
</script>

<Layout seo={seo}>
  <article class="mx-auto max-w-full" aria-labelledby="article-title" data-article-slug={content.slug}>
    <Head content={content} />

    {content.audio_narration && (
      <div class="mt-6 rounded-xl border border-accent/25 bg-gradient-to-r from-accent/[0.08] via-accent/[0.04] to-transparent px-5 py-4">
        <AudioPlayer client:load src={content.audio_narration} title={content.title} banner={true} />
      </div>
    )}

    <div class="mt-10 grid grid-cols-1 xl:grid-cols-[220px_1fr] xl:gap-x-12">
      <Aside content={content} timeToRead={timeToRead} twitterShare={twitterShare} linkedInShare={linkedInShare} />

      <div class="min-w-0">
        <div id="article-body" class="pb-12 max-w-none prose-invert">
          <slot />
        </div>

        <div class="border-t border-border pt-10">
          <GiscusWrapper client:load slug={content.slug} />
        </div>
      </div>
    </div>
  </article>
</Layout>
