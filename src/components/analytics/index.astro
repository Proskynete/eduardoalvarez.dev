---
import { PUBLIC_GA_ID } from "astro:env/client";

import CookiePreferences from "./cookie-preferences";

/**
 * Google Analytics 4 behind the visitor's cookie decision (`utils/consent.ts`).
 *
 * Statistics follow the stored decision or, before the visitor acts, the region
 * default: ON outside Europe (opt-out, the notice informs), OFF in Europe
 * (opt-in, nothing goes to Google until «Aceptar»). Switching them off after
 * they were on sets `ga-disable-<ID>` and deletes the `_ga*` cookies.
 *
 * Only in production builds and only with PUBLIC_GA_ID: in dev, CI or a build
 * without the variable, neither the loader, the notice nor the panel is
 * rendered. Vercel Web Analytics (cookieless) counts every visit regardless.
 *
 * Page views: the ClientRouter navigates with the History API, which GA4's
 * enhanced measurement already counts as page views.
 */
const gaId = import.meta.env.PROD ? PUBLIC_GA_ID : undefined;
---

{
  gaId && (
    <>
      <script is:inline define:vars={{ gaId }}>
        // Inline so the functions exist before any module runs; guarded because
        // the ClientRouter re-executes inline scripts on navigation.
        if (!window.loadAnalytics) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.loadAnalytics = function () {
            window["ga-disable-" + gaId] = false;
            if (window.analyticsLoaded) return;
            window.analyticsLoaded = true;
            var script = document.createElement("script");
            script.async = true;
            script.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
            document.head.appendChild(script);
            window.gtag("js", new Date());
            window.gtag("config", gaId);
          };
          window.disableAnalytics = function () {
            window["ga-disable-" + gaId] = true;
            // Delete GA's cookies (_ga, _ga_XXXX) on this host and its registrable domain.
            var host = location.hostname;
            var domains = ["", host, "." + host.split(".").slice(-2).join(".")];
            document.cookie.split(";").forEach(function (cookie) {
              var name = cookie.split("=")[0].trim();
              if (name.indexOf("_ga") !== 0) return;
              domains.forEach(function (domain) {
                document.cookie = name + "=; Max-Age=0; path=/" + (domain ? "; domain=" + domain : "");
              });
            });
          };
        }
      </script>
      <script>
        import {
          type ConsentState,
          forgetPreferencesUnlessAllowed,
          getConsent,
          onConsentChange,
          openCookiePreferences,
        } from "../../utils/consent";

        type AnalyticsWindow = Window & { loadAnalytics?: () => void; disableAnalytics?: () => void };

        // A module: runs once per full page load, not on ClientRouter navigations.
        const apply = (consent: ConsentState) => {
          const w = window as AnalyticsWindow;
          if (consent.statistics) w.loadAnalytics?.();
          else w.disableAnalytics?.();
          forgetPreferencesUnlessAllowed(consent);
        };
        apply(getConsent());
        onConsentChange(apply);

        // The footer's «./cookies». Delegated once on the document, so it survives navigations.
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target?.closest("[data-cookie-preferences]")) return;
          event.preventDefault();
          openCookiePreferences();
        });
      </script>
      <CookiePreferences client:load transition:persist="cookie-preferences" />
    </>
  )
}
