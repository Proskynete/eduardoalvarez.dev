---
import { PUBLIC_GA_ID } from "astro:env/client";

import CookieBanner from "./cookie-banner.astro";

/**
 * Google Analytics 4 behind consent.
 *
 * gtag.js is NOT requested until the visitor accepts in the banner. Before a
 * decision, or after «No, gracias», nothing goes to Google. Declining after
 * accepting sets `ga-disable-<ID>` and deletes the `_ga*` cookies.
 *
 * This replaced the Partytown version: Partytown loaded GA on every visit, and a
 * worker that proxies `gtag` cannot be held back until a click without loading
 * it first. The script is async and small; it no longer runs for everybody.
 *
 * Only in production builds and only with PUBLIC_GA_ID: in dev, CI or a build
 * without the variable, neither the loader nor the banner is rendered.
 *
 * Page views: the ClientRouter navigates with the History API, which GA4's
 * enhanced measurement already counts as page views.
 */
const gaId = import.meta.env.PROD ? PUBLIC_GA_ID : undefined;
---

{
  gaId && (
    <>
      <script is:inline define:vars={{ gaId }}>
        // Inline so the decision is applied before anything else runs; guarded
        // because the ClientRouter re-executes inline scripts on navigation.
        if (!window.loadAnalytics) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () {
            window.dataLayer.push(arguments);
          };
          window.loadAnalytics = function () {
            window["ga-disable-" + gaId] = false;
            if (window.analyticsLoaded) return;
            window.analyticsLoaded = true;
            var script = document.createElement("script");
            script.async = true;
            script.src = "https://www.googletagmanager.com/gtag/js?id=" + gaId;
            document.head.appendChild(script);
            window.gtag("js", new Date());
            window.gtag("config", gaId);
          };
          window.disableAnalytics = function () {
            window["ga-disable-" + gaId] = true;
            // Delete GA's cookies (_ga, _ga_XXXX) on this host and its parent domain.
            var host = location.hostname;
            var domains = ["", host, "." + host.split(".").slice(-2).join(".")];
            document.cookie.split(";").forEach(function (cookie) {
              var name = cookie.split("=")[0].trim();
              if (name.indexOf("_ga") !== 0) return;
              domains.forEach(function (domain) {
                document.cookie = name + "=; Max-Age=0; path=/" + (domain ? "; domain=" + domain : "");
              });
            });
          };
          try {
            if (localStorage.getItem("cookie-consent") === "granted") window.loadAnalytics();
          } catch (e) {}
        }
      </script>
      <CookieBanner />
    </>
  )
}
