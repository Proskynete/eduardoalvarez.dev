---
import BrandFin from "../brand-fin/index.astro";

// Animated PWA splash screen — shows only in standalone mode (iOS & Android PWA),
// once per session. The fin powers on and the wordmark follows: ~1.5s.
//
// The fin is `BrandFin`, the library's Isotype, and not a path drawn here. The
// old one was a hand-written silhouette in accent, with spots and no wave: the
// icon on the home screen and the splash that opened from it were two different
// marks. It also ran ~4.3s, long enough to read as the app being slow.
//
// The fin starts already visible, in the place and at the size the iOS launch
// image draws it (see `STARTUP` in scripts/brand.mjs), so the static image hands
// over to this page without a jump; only the glow and the wordmark animate.
---

<div id="pwa-splash" aria-hidden="true" role="presentation">
  <div class="splash-inner">
    <div class="splash-fin">
      <BrandFin class="h-28 w-auto" />
    </div>

    <!-- Wordmark: fades in once the fin is up -->
    <div class="splash-logotype">
      <div class="splash-separator"></div>
      <div class="splash-text">
        <span class="splash-name">Eduardo Álvarez</span>
        <span class="splash-tagline">Engineering Leadership · Platform Thinking</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /*
    Cero hexadecimales literales — regla 1 del sistema. El fondo, el brillo y el
    texto salen de los tokens, así que la pantalla de arranque sigue el tema; la
    aleta la resuelve `BrandFin` (espuma sobre oscuro, dos azules sobre claro).
  */
  #pwa-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-background);
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #pwa-splash.is-active {
    display: flex;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .splash-logotype {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
  }

  .splash-separator {
    width: 32px;
    height: 1px;
    background: color-mix(in oklab, var(--color-accent) 50%, transparent);
  }

  .splash-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
  }

  .splash-name {
    color: var(--color-text-primary);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .splash-tagline {
    color: var(--color-text-muted);
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 10px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  #pwa-splash.is-exit {
    animation: splash-exit 0.3s ease-out forwards;
    pointer-events: none;
  }

  /* ─── Keyframes ─── */

  @keyframes glow-on {
    from {
      filter: drop-shadow(0 0 0 transparent);
    }
    to {
      filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-accent) 45%, transparent))
        drop-shadow(0 0 28px color-mix(in oklab, var(--color-accent) 20%, transparent));
    }
  }

  @keyframes splash-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes logotype-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Sequence (.is-drawing fires everything) ─── */

  /* 1. The fin powers on */
  #pwa-splash.is-drawing .splash-fin {
    animation: glow-on 0.5s ease-out 0.1s forwards;
  }

  /* 2. The wordmark enters */
  #pwa-splash.is-drawing .splash-logotype {
    animation: logotype-in 0.4s ease-out 0.3s forwards;
  }

  /* No animation: jump straight to the finished state */
  @media (prefers-reduced-motion: reduce) {
    #pwa-splash.is-drawing .splash-fin {
      animation: none;
    }
    #pwa-splash.is-drawing .splash-logotype {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const splash = document.getElementById("pwa-splash");
  if (splash) {
    const isStandalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      (window.navigator as unknown as { standalone?: boolean }).standalone === true;

    const alreadyShown = sessionStorage.getItem("pwa-splash-shown");

    if (isStandalone && !alreadyShown) {
      sessionStorage.setItem("pwa-splash-shown", "true");

      splash.classList.add("is-active");

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          splash.classList.add("is-drawing");
        });
      });

      setTimeout(() => {
        splash.classList.add("is-exit");
        setTimeout(() => splash.remove(), 300);
      }, 1200);
    } else {
      splash.remove();
    }
  }
</script>
