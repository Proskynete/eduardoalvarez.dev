---
// Animated PWA splash screen — shows only in standalone mode (iOS & Android PWA)
// The fin draws in one stroke, fills, grows its spots and powers on. ~3.5s total.
const FIN =
  "M12 52 C16 38 24 18 40 8 C44 5.5 47 8 45.5 13 C40 30 42 42 54 51 C56 52.5 55 55 52 55 L15 55 C11.5 55 11 54 12 52 Z";

/** Same spots as the brand mark. They stagger in, bottom to top. */
const SPOTS = [
  { cx: 26, cy: 43, r: 2.4 },
  { cx: 35, cy: 45, r: 2.1 },
  { cx: 44, cy: 47, r: 1.8 },
  { cx: 33, cy: 33, r: 2.2 },
  { cx: 24, cy: 33, r: 1.8 },
  { cx: 38, cy: 22, r: 1.7 },
];
---

<div id="pwa-splash" aria-hidden="true" role="presentation">
  <div class="splash-inner">
    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" width="140" height="140" aria-hidden="true">
      <!-- 1. The outline draws in a single stroke -->
      <path
        class="fin-stroke"
        d={FIN}
        fill="none"
        stroke="#35d6c0"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        pathLength="100"></path>
      <!-- 2. The fill comes in behind the stroke -->
      <path class="fin-fill" d={FIN} fill="#35d6c0"></path>
      <!-- 3. The spots stagger in -->
      <g class="fin-spots">
        {
          SPOTS.map((m, i) => (
            <circle cx={m.cx} cy={m.cy} r={m.r} fill="#091319" opacity="0.45" style={`--i:${i}`} />
          ))
        }
      </g>
    </svg>

    <!-- Wordmark: fades in after the fin finishes drawing -->
    <div class="splash-logotype">
      <div class="splash-separator"></div>
      <div class="splash-text">
        <span class="splash-name">Eduardo Álvarez</span>
        <span class="splash-tagline">Engineering Leadership · Platform Thinking</span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #pwa-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #091319;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  #pwa-splash.is-active {
    display: flex;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  .splash-logotype {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
  }

  .splash-separator {
    width: 32px;
    height: 1px;
    background: rgba(53, 214, 192, 0.5);
  }

  .splash-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
  }

  .splash-name {
    color: #edf4f3;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .splash-tagline {
    color: #71919c;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 10px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  #pwa-splash.is-exit {
    animation: splash-exit 0.5s ease-out forwards;
    pointer-events: none;
  }

  /* ── Initial state: only the stroke exists, undrawn ── */
  #pwa-splash .fin-stroke {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  #pwa-splash .fin-fill,
  #pwa-splash .fin-spots circle {
    opacity: 0;
  }

  /* ─── Keyframes ─── */

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fill-in {
    to {
      opacity: 1;
    }
  }

  /* The spots pop in slightly rather than fading flat */
  @keyframes spot-in {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 0.45;
      transform: scale(1);
    }
  }

  @keyframes glow-on {
    0% {
      filter: drop-shadow(0 0 2px #35d6c0);
    }
    100% {
      filter: drop-shadow(0 0 6px #35d6c0) drop-shadow(0 0 16px rgba(53, 214, 192, 0.6))
        drop-shadow(0 0 32px rgba(53, 214, 192, 0.25));
    }
  }

  @keyframes splash-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes logotype-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ─── Sequence (.is-drawing fires everything) ─── */

  /* 1. The outline draws */
  #pwa-splash.is-drawing .fin-stroke {
    animation: draw 1.2s ease-in-out 0.1s forwards;
  }

  /* 2. The fill rises behind it */
  #pwa-splash.is-drawing .fin-fill {
    animation: fill-in 0.5s ease-out 1.3s forwards;
  }

  /* 3. Staggered spots — 70ms apart */
  #pwa-splash.is-drawing .fin-spots circle {
    transform-box: fill-box;
    transform-origin: center;
    animation: spot-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: calc(1.8s + var(--i) * 70ms);
  }

  /* 4. Powers on */
  #pwa-splash.is-drawing .splash-inner svg {
    animation: glow-on 0.9s ease-in 2.3s forwards;
  }

  /* 5. The wordmark enters */
  #pwa-splash.is-drawing .splash-logotype {
    animation: logotype-in 0.5s ease-out 2.7s forwards;
  }

  /* No animation: jump straight to the finished state */
  @media (prefers-reduced-motion: reduce) {
    #pwa-splash.is-drawing .fin-stroke {
      animation: none;
      stroke-dashoffset: 0;
    }
    #pwa-splash.is-drawing .fin-fill {
      animation: none;
      opacity: 1;
    }
    #pwa-splash.is-drawing .fin-spots circle {
      animation: none;
      opacity: 0.45;
    }
    #pwa-splash.is-drawing .splash-inner svg {
      animation: none;
      filter: drop-shadow(0 0 6px #35d6c0) drop-shadow(0 0 16px rgba(53, 214, 192, 0.6));
    }
    #pwa-splash.is-drawing .splash-logotype {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  const splash = document.getElementById("pwa-splash");
  if (splash) {
    const isStandalone =
      window.matchMedia("(display-mode: standalone)").matches ||
      (window.navigator as unknown as { standalone?: boolean }).standalone === true;

    const alreadyShown = sessionStorage.getItem("pwa-splash-shown");

    if (isStandalone && !alreadyShown) {
      sessionStorage.setItem("pwa-splash-shown", "true");

      splash.classList.add("is-active");

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          splash.classList.add("is-drawing");
        });
      });

      setTimeout(() => {
        splash.classList.add("is-exit");
        setTimeout(() => splash.remove(), 500);
      }, 3800);
    } else {
      splash.remove();
    }
  }
</script>
