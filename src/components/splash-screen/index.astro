---
import { Isotype } from "@eduardoalvarez/arrecife/brand";

// Animated PWA splash screen — standalone only (iOS & Android PWA), once per
// session, ~1.5 s. `splashScript` (./script.ts) decides in <head>, before the
// first paint, and sets `data-pwa-splash` on <html>; everything else is CSS.
//
// It continues the iOS launch image instead of replacing it, so the hand-off is
// invisible:
// - Same ground: always dark (`data-theme="dark"`), like the launch image, even
//   when the visitor reads in light mode. The page fades in after it.
// - Same fin, same place: 112 px tall, its centre 38.5 px above the SCREEN's
//   (`STARTUP` in scripts/brand.mjs draws the launch images with those numbers;
//   change both together). The screen's, not the viewport's: on iOS the page
//   starts below the status bar, and the script measures by how much.
//   Positioned absolutely, so neither the wordmark nor the fonts can move it.
// - From the first frame: `<html>` itself paints the ground and the fin, so
//   nothing depends on `<body>` having arrived (the inlined CSS puts it ~130 KB
//   into the document). The splash element then covers it with the same image.
// Then only the glow and the wordmark animate.
---

<div id="pwa-splash" data-theme="dark" aria-hidden="true" role="presentation">
  <div class="splash-fin">
    <Isotype background="dark" alt="" decoding="sync" fetchPriority="high" />
  </div>

  <!-- Wordmark: fades in once the fin is up -->
  <div class="splash-logotype">
    <div class="splash-separator"></div>
    <div class="splash-text">
      <span class="splash-name">Eduardo Álvarez</span>
      <span class="splash-tagline">entender · construir · compartir</span>
    </div>
  </div>
</div>

<style is:global>
  /*
    Cero hexadecimales literales — regla 1 del sistema. `data-theme="dark"` en
    el contenedor resuelve los tokens oscuros aunque la página esté en claro.
  */
  #pwa-splash {
    --splash-fin-top: calc(50% - var(--splash-fin-lift) - var(--splash-offset) / 2 - var(--splash-fin-height) / 2);

    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--color-background);
    display: none;
  }

  /* The launch image again, painted by <html> while <body> is still on its way.
     `min-height` gives the root a viewport-tall box to centre in; iOS ignores
     `background-attachment: fixed`. */
  html[data-pwa-splash] {
    /* Must match STARTUP in scripts/brand.mjs. */
    --splash-fin-height: 112px;
    --splash-fin-lift: 38.5px;
    /* What the iOS status bar takes from the top of the viewport; the launch
       image centres on the screen, not on the viewport. See script.ts. */
    --splash-offset: var(--pwa-splash-offset, 0px);

    min-height: 100%;
    background: var(--pwa-splash-ground) url("/brand/fin-foam.png") no-repeat;
    background-size: auto var(--splash-fin-height);
    background-position: 50% calc(50% - var(--splash-fin-lift) - var(--splash-offset) / 2);
  }

  html[data-pwa-splash] #pwa-splash {
    display: block;
    animation: splash-exit 0.3s ease-out 1.2s forwards;
  }

  .splash-fin {
    position: absolute;
    top: var(--splash-fin-top);
    left: 50%;
    height: var(--splash-fin-height);
    transform: translateX(-50%);
  }

  .splash-fin img {
    display: block;
    height: 100%;
    width: auto;
  }

  .splash-logotype {
    position: absolute;
    top: calc(var(--splash-fin-top) + var(--splash-fin-height) + 28px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
  }

  .splash-separator {
    width: 32px;
    height: 1px;
    background: color-mix(in oklab, var(--color-accent) 50%, transparent);
  }

  .splash-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
  }

  /* The level-1 lockup's type (manual § 03): wordmark in Bricolage Grotesque
     700 uppercase with 0.04em tracking, and the line in mono with 0.28em. */
  .splash-name {
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* 13px: the manual's minimum on screen, and the one muted text needs. */
  .splash-tagline {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    letter-spacing: 0.28em;
    /* The tracking also follows the last letter; this puts the line back on centre. */
    padding-inline-start: 0.28em;
  }

  /* ─── Sequence ─── */

  /* 1. The fin powers on */
  html[data-pwa-splash] .splash-fin {
    animation: glow-on 0.5s ease-out 0.1s forwards;
  }

  /* 2. The wordmark enters */
  html[data-pwa-splash] .splash-logotype {
    animation: logotype-in 0.4s ease-out 0.3s forwards;
  }

  /* 3. The splash fades out over the page (on #pwa-splash, above) */

  @keyframes glow-on {
    from {
      filter: drop-shadow(0 0 0 transparent);
    }
    to {
      filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-accent) 45%, transparent))
        drop-shadow(0 0 28px color-mix(in oklab, var(--color-accent) 20%, transparent));
    }
  }

  @keyframes logotype-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes splash-exit {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* No animation: the finished state, then out */
  @media (prefers-reduced-motion: reduce) {
    html[data-pwa-splash] .splash-fin {
      animation: none;
    }
    html[data-pwa-splash] .splash-logotype {
      animation: none;
      opacity: 1;
    }
  }
</style>
