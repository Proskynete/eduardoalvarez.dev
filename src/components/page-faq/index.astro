---
import type { FAQItem } from "../../interfaces";
import FaqAccordion from "./faq-accordion";

export interface Props {
  faq?: FAQItem[];
  title?: string;
}

const { faq, title = "Preguntas frecuentes" } = Astro.props;

const hasItems = faq && faq.length > 0;

const schema = hasItems
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer,
        },
      })),
    }
  : null;
---

{
  hasItems && (
    <section class="mt-16 pt-12 border-t border-border">
      <h2 class="text-text-primary mb-6">{title}</h2>
      {/*
        Hydrated on purpose, and only here: the accordion has to track which item
        is open. `client:visible` keeps it off the critical path — the FAQ sits at
        the foot of the page — and this is one route, not the base layout, which
        is where hydrating the library once cost 332 KB.
      */}
      <FaqAccordion client:visible items={faq!} />
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    </section>
  )
}
