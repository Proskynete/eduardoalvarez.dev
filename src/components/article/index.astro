---
import type { Article } from "../../interfaces";
import { prettyDate } from "../../utils/date";

export const prerender = true;

export interface Props {
  article: Article;
  headingLevel?: 2 | 3;
}

const { article, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

{/*
  Article card — design system spec: bg #0B1620, border #1E3441, radius 14,
  padding 26, hover border #2C4D5D. Category pill in arena with its own border,
  date in mono, `./leer →` link in bioluz mono.

  These used to be rows separated by full-width 1px rules, which read as a table
  instead of as objects. The card gives them body.
*/}
<article
  data-testid="article-card"
  class="group h-full rounded-[14px] border border-[#1e3441] bg-[#0b1620] p-card-pad transition-colors duration-200 hover:border-[#2c4d5d] focus-within:border-[#2c4d5d]"
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    {
      article.categories?.[0] && (
        <span
          data-testid="category-pill"
          class="inline-block rounded-full border border-[#4a3a25] bg-warm/10 px-[10px] py-[3px] font-mono text-[11.5px] uppercase leading-snug tracking-[0.06em] text-warm"
        >
          {article.categories[0]}
        </span>
      )
    }
    <time datetime={article.date} class="font-mono text-xs text-text-muted">
      {prettyDate(article.date)}
    </time>
  </div>

  <Heading
    class="mt-4 font-display text-[25px] font-semibold leading-[1.15] tracking-tight text-text-primary"
  >
    <a
      href={`/articles/${article.slug}`}
      class="outline-hidden transition-colors duration-200 group-hover:text-accent focus-visible:text-accent"
    >
      {article.title}
    </a>
  </Heading>

  <p class="mt-3 line-clamp-3 text-[15px] leading-relaxed text-text-secondary">
    {article.excerpt}
  </p>

  <span
    class="mt-5 inline-flex items-center gap-1 font-mono text-[13px] text-accent transition-transform duration-200 group-hover:translate-x-0.5"
    aria-hidden="true"
  >
    ./leer&nbsp;→
  </span>
</article>
