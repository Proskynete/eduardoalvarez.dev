---
import { ArticleCard } from "@eduardoalvarez/arrecife";

import type { Article } from "../../interfaces";
import { prettyDate } from "../../utils/date";

export const prerender = true;

export interface Props {
  article: Article;
  headingLevel?: 2 | 3;
}

const { article } = Astro.props;
---

{/*
  The card now comes from @eduardoalvarez/arrecife rather than being rebuilt
  here. Rendered without a client directive, so Astro emits it as static HTML
  and the listing still ships no JavaScript.

  The library composes it differently on purpose, and those differences are the
  design system correcting this file rather than a regression:

  · The metadata line leads with the date and the category moves to the foot of
    the card. A slug is a label, not an eyebrow.
  · The `./leer →` affordance is gone. It moved on hover
    (`group-hover:translate-x-0.5`), and states are communicated with border and
    colour, never with movement.
  · Colours come from tokens. This file had #0b1620, #1e3441, #4a3a25 and
    #2c4d5d written by hand, which is exactly the drift a published scale ends.
    The card surface is now `surface`, a correction the library made
    deliberately against the original handoff.

  Reading time is left out. The library offers it, but the only text available
  here is the excerpt, and a figure derived from that would be a number that
  looks measured and is not.

  `headingLevel` stays in the props for the two call sites but is no longer
  used: the library fixes the heading at h3 so a card cannot claim a level its
  position in the page has not earned.
*/}
<ArticleCard
  data-testid="article-card"
  href={`/articles/${article.slug}`}
  title={article.title}
  excerpt={article.excerpt}
  date={prettyDate(article.date)}
  dateTime={article.date}
  tags={article.categories?.slice(0, 1)}
  className="h-full"
/>
