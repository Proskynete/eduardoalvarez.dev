---
/**
 * Brand fin — level 3 of the mark system, and the only level allowed to stand
 * alone below 120px. Minimum 16px.
 *
 * CRITICAL RULE from the design system: the two-blue fin has a #0B1524 body and
 * DISAPPEARS on dark grounds; the foam one disappears on light grounds. Both are
 * rendered and CSS picks — solved here rather than at every call site, which is
 * exactly where it gets forgotten.
 *
 * PROVISIONAL: PNG files cropped from the sticker sheet (147×111). Once the vector
 * exists these must be replaced — a crisp favicon, embroidery and print over
 * 200mm all need it.
 */
interface Props {
  class?: string;
  /** Alt text. Empty by default: the wrapping link already names it. */
  alt?: string;
}

const { class: className = "", alt = "" } = Astro.props;
const shared = `object-contain ${className}`;
---

<img
  src="/brand/fin-foam.png"
  alt={alt}
  width="147"
  height="111"
  loading="eager"
  decoding="async"
  class={`block light:hidden ${shared}`}
  aria-hidden={alt === "" ? "true" : undefined}
/>
<img
  src="/brand/fin.png"
  alt={alt}
  width="147"
  height="111"
  loading="eager"
  decoding="async"
  class={`hidden light:block ${shared}`}
  aria-hidden={alt === "" ? "true" : undefined}
/>
