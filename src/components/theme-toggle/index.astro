---
/**
 * Theme switch. The head script already set `data-theme` before first paint;
 * this only toggles and persists.
 */
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Switch between light and dark mode"
  class="flex size-control-icon flex-none items-center justify-center rounded-control border border-hairline-hover text-text-primary transition-colors duration-200 hover:border-accent hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-accent"
>
  <svg class="block dark:block" data-icon="moon" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linejoin="round"></path>
  </svg>
  <svg data-icon="sun" width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"></path>
  </svg>
</button>

<style is:global>
  [data-icon="sun"] {
    display: none;
  }
  html[data-theme="light"] [data-icon="moon"] {
    display: none;
  }
  html[data-theme="light"] [data-icon="sun"] {
    display: block;
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    // With ClientRouter this runs twice on first load — once when the script
    // evaluates and once on `astro:page-load`. Without the guard two listeners
    // register and a single click toggles twice, i.e. does nothing.
    if (btn.dataset.ready === "1") return;
    btn.dataset.ready = "1";

    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "light" ? "dark" : "light";
      document.documentElement.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Private mode or blocked storage: the theme lasts the session.
      }
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
