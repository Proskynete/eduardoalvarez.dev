---
import { PageHeader, categoryBadgeVariants } from "@eduardoalvarez/arrecife";
import type { GetStaticPaths } from "astro";

import Article from "../../../components/article/index.astro";
import type { Article as IArticle, CategoryAllowed } from "../../../interfaces";
import Layout from "../../../layouts/main/index.astro";
import settings from "../../../settings";
import { articlesSort } from "../../../utils/articles";
import { CategoryMap } from "../../../utils/categories";

export const prerender = true;

type Frontmatter = IArticle;

/**
 * Una ruta por categoría en vez del filtro por JavaScript que había antes.
 *
 * Con paginación el filtro dejaba de funcionar: escondía artículos de la página
 * que estás viendo, así que «Cultura de Ingeniería» te habría mostrado los de esa
 * categoría entre los cinco de esta página, no entre los nueve. Además cada
 * categoría pasa a tener URL propia, que se puede compartir e indexar.
 */
export const getStaticPaths = (() => {
  const posts = Object.values(import.meta.glob<{ frontmatter: Frontmatter }>("../*.mdx", { eager: true }));
  const categorias = [...new Set(posts.flatMap((p) => p.frontmatter.categories ?? []))];
  return categorias.map((categoria) => ({
    params: { categoria },
    props: {
      categoria,
      posts: posts.filter((p) => p.frontmatter.categories?.includes(categoria)).sort(articlesSort),
      categorias,
    },
  }));
}) satisfies GetStaticPaths;

const { categoria, posts, categorias } = Astro.props as {
  categoria: CategoryAllowed;
  posts: { frontmatter: Frontmatter }[];
  categorias: CategoryAllowed[];
};

const nombre = CategoryMap.get(categoria) ?? categoria;

const seo = {
  title: `${nombre} — Artículos`,
  description: `Artículos sobre ${nombre.toLowerCase()}.`,
  schema: {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${nombre} — Eduardo Álvarez`,
    url: `${settings.url}/articles/categoria/${categoria}`,
    hasPart: posts.map(({ frontmatter }) => ({
      "@type": "BlogPosting",
      headline: frontmatter.title,
      url: `${settings.url}/articles/${frontmatter.slug}`,
      datePublished: frontmatter.date,
    })),
  },
};
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full">
    <PageHeader
      eyebrow="/artículos"
      title={nombre}
      description={`${posts.length} ${posts.length === 1 ? "artículo" : "artículos"} en esta categoría.`}
    />

    <nav class="mb-step-xl gap-step-xs flex flex-wrap" aria-label="Filtrar por categoría">
      <a href="/articles" class={categoryBadgeVariants()}>Todos</a>
      {
        categorias.map((cat) => (
          <a
            href={`/articles/categoria/${cat}`}
            class={categoryBadgeVariants({ active: cat === categoria })}
            aria-current={cat === categoria ? "page" : undefined}
          >
            {CategoryMap.get(cat) ?? cat}
          </a>
        ))
      }
    </nav>

    <div class="gap-step-md grid sm:grid-cols-2" role="list">
      {
        posts.map((post) => (
          <div role="listitem">
            <Article article={post.frontmatter} headingLevel={2} />
          </div>
        ))
      }
    </div>
  </div>
</Layout>
