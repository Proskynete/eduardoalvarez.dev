---
import Layout from "../layouts/main/index.astro";

export const prerender = true;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content pt-step-xl flex flex-col items-center text-center">
    {
      /*
      Just the face. The page went through a fin that drew itself and broke, a
      mouth drawn in SVG that came out a flat geometric wedge, and a krill scene
      animated in CSS — each one more machinery than a page nobody visits on
      purpose can justify. The mascot's own art says it on its own.

      `annoyed` and not `confused`: `usoDeCara` assigns `confused` to the 404 and
      `annoyed` to a server error, but the library's own EmptyState story labels
      an `annoyed` example "404". The catalogue and the story disagree; worth
      settling on the library side.
    */
    }
    <img
      src="/brand/face-annoyed.png"
      alt=""
      aria-hidden="true"
      width="121"
      height="121"
      class="mb-step-lg h-auto w-33"
      loading="eager"
      decoding="async"
    />

    <p class="mb-4 font-mono text-xs uppercase tracking-[0.12em] text-accent">404 · aguas desconocidas</p>

    <h1 class="mb-3 text-text-primary">Página no encontrada</h1>
    <p class="mb-step-xl max-w-sm text-base text-text-secondary sm:text-lg">
      Nadaste fuera del mapa. Volvamos a la superficie.
    </p>

    <div class="grid w-full grid-cols-2 gap-3">
      {
        suggestions.map(({ href, label, description }) => (
          <a
            href={href}
            class="group rounded-xl border border-border bg-surface p-4 text-left transition-colors duration-200 hover:border-accent"
          >
            <p class="mb-1 text-sm font-semibold text-text-primary transition-colors duration-200 group-hover:text-accent">
              {label}
            </p>
            <p class="text-xs leading-relaxed text-text-muted">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
