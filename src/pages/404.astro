---
import { EmptyState, LinkRow } from "@eduardoalvarez/arrecife";

import Layout from "../layouts/main/index.astro";

export const prerender = true;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content pt-step-xl gap-step-lg flex flex-col">
    {
      /*
      `EmptyState variant="page"` is the library's shape for a screen that IS an
      empty state, and the 404 is the canonical one. It brings the face, the
      surface, the title and the line under it, which this page drew by hand.

      `confused` and not `annoyed`: `faceUsage`, which ships inside the package,
      reads «404, page not found» for `confused` and reserves `annoyed` for a
      server error. The old comment here bet on the library's story file instead;
      the catalogue in code is the one that settles it.
    */
    }
    <EmptyState
      variant="page"
      expression="confused"
      title="Página no encontrada"
      description="Nadaste fuera del mapa. Volvamos a la superficie."
    />

    {/* `LinkRow` instead of four hand-built cards: the name, the description and
        the hover that only changes the border are the component's, and the
        `rounded-xl border border-border bg-surface p-4` written here was a card
        rebuilt from scratch. */}
    <div class="gap-step-sm grid sm:grid-cols-2">
      {
        suggestions.map(({ href, label, description }) => (
          <LinkRow href={href} name={label} description={description} />
        ))
      }
    </div>
  </div>
</Layout>
