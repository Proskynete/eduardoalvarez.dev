---
import Layout from "../layouts/main/index.astro";

export const prerender = true;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content py-24 flex flex-col items-center text-center">

    <!-- Broken drawing of the fin: the canonical stroke split into three
         segments. The leading edge completes, the trailing edge stalls halfway,
         the base barely starts and the spots never land. -->
    <div class="mb-10" aria-hidden="true">
      <div class="crash-container">
        <svg width="132" height="132" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
          <!-- ── Phase 1: leading edge — draws fully, confidently ── -->
          <path
            class="p1"
            d="M12 52 C16 38 24 18 40 8 C44 5.5 47 8 45.5 13"
            fill="none"
            stroke="#35d6c0"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="100"
          />
          <!-- Faint inner echo: trails the leading edge by half a beat -->
          <path
            class="p1-detail"
            d="M16.5 50 C20 38 26.5 21 39.5 12"
            fill="none"
            stroke="#35d6c0"
            stroke-width="0.7"
            stroke-linecap="round"
            pathLength="100"
          />

          <!-- ── Phase 2: trailing edge — reaches 78% and collapses ── -->
          <path
            class="p2"
            d="M45.5 13 C40 30 42 42 54 51 C56 52.5 55 55 52 55"
            fill="none"
            stroke="#35d6c0"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="100"
          />

          <!-- ── Phase 3: the base — barely starts, then freezes ── -->
          <path
            class="p3"
            d="M52 55 L15 55 C11.5 55 11 54 12 52"
            fill="none"
            stroke="#35d6c0"
            stroke-width="1"
            stroke-linecap="round"
            stroke-linejoin="round"
            pathLength="100"
          />

          <!-- ── Phase 4: the spots — flicker once and never arrive ── -->
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="26" cy="43" r="2.4" pathLength="100" />
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="35" cy="45" r="2.1" pathLength="100" />
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="44" cy="47" r="1.8" pathLength="100" />
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="33" cy="33" r="2.2" pathLength="100" />
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="24" cy="33" r="1.8" pathLength="100" />
          <circle class="p4" fill="none" stroke="#35d6c0" stroke-width="0.7" cx="38" cy="22" r="1.7" pathLength="100" />
        </svg>
      </div>
    </div>

    <!-- Error label -->
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent mb-4">404 · aguas desconocidas</p>

    <!-- Heading -->
    <h1 class="text-text-primary mb-3">
      Página no encontrada
    </h1>
    <p class="text-text-secondary text-base sm:text-lg mb-12 max-w-sm">
      Nadaste fuera del mapa. Volvamos a la superficie.
    </p>

    <!-- Destination grid -->
    <div class="w-full grid grid-cols-2 gap-3">
      {
        suggestions.map(({ href, label, description }) => (
          <a
            href={href}
            class="group p-4 text-left rounded-xl border border-border bg-surface hover:border-accent transition-colors duration-200"
          >
            <p class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 mb-1">
              {label}
            </p>
            <p class="text-xs text-text-muted leading-relaxed">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  /* ── Base: normalize all strokes for dashoffset animation ── */
  .crash-container svg path,
  .crash-container svg circle {
    stroke-dasharray: 100;
  }

  /* ── Phase 1: leading edge — draws fully ──
     stroke-dashoffset set on the same selector as the animation to avoid
     iOS WebKit specificity bug (higher-specificity base rule blocks animation) */
  .p1 {
    stroke-dashoffset: 100;
    animation: draw-full 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
  }
  .p1-detail {
    stroke-dashoffset: 100;
    stroke-opacity: 0.5;
    animation: draw-full 0.6s ease-out 0.7s forwards;
  }

  /* ── Phase 2: trailing edge — reaches 78% and collapses ── */
  .p2 {
    stroke-dashoffset: 100;
    animation: draw-and-crash 1.0s ease-in-out 1.1s forwards;
  }

  /* ── Phase 3: the base — barely starts, frozen ── */
  .p3 {
    stroke-dashoffset: 100;
    animation: draw-freeze 0.6s ease-out 1.6s forwards;
  }

  /* ── Phase 4: spots — flicker once and go ── */
  .p4 {
    stroke-dashoffset: 100;
    animation: blink-out 0.35s ease-out 1.82s forwards;
  }

  /* ── Container: shake → dim → broken idle ──
     Uses opacity instead of filter for iOS compatibility
     (filter on SVG containers breaks rendering in iOS Chrome/PWA) */
  .crash-container {
    display: inline-block;
    transform: translateZ(0); /* force GPU layer — helps iOS animation */
    animation:
      crash-shake 0.25s ease-in-out 1.78s 1 both,
      post-crash  0.45s ease-out    2.05s 1 forwards,
      broken-idle 6s   ease-in-out  2.6s  infinite;
  }

  /* ─────────────────────── Keyframes ─────────────────────── */

  @keyframes draw-full {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: 0; }
  }

  @keyframes draw-and-crash {
    0%   { stroke-dashoffset: 100; opacity: 1; }
    52%  { stroke-dashoffset: 22;  opacity: 1; }   /* 78% drawn — looking good  */
    60%  { stroke-dashoffset: 40;  opacity: 0.3; } /* CRASH: jump back + flicker */
    66%  { stroke-dashoffset: 24;  opacity: 1; }   /* stutter recovery attempt  */
    73%  { stroke-dashoffset: 56;  opacity: 0.5; } /* hard fail                 */
    100% { stroke-dashoffset: 54;  opacity: 0.6; } /* frozen broken             */
  }

  @keyframes draw-freeze {
    0%   { stroke-dashoffset: 100; opacity: 1; }
    42%  { stroke-dashoffset: 60;  opacity: 1; }    /* 40% drawn                 */
    52%  { stroke-dashoffset: 60;  opacity: 0.1; }  /* blink off at crash        */
    60%  { stroke-dashoffset: 60;  opacity: 0.6; }  /* flash                     */
    70%  { stroke-dashoffset: 60;  opacity: 0.15; } /* off again                 */
    100% { stroke-dashoffset: 63;  opacity: 0.38; } /* barely visible, frozen    */
  }

  @keyframes blink-out {
    0%   { stroke-dashoffset: 100; opacity: 0; }
    35%  { stroke-dashoffset: 88;  opacity: 0.55; } /* briefly appears */
    65%  { stroke-dashoffset: 88;  opacity: 0; }    /* gone            */
    100% { stroke-dashoffset: 100; opacity: 0; }
  }

  /* opacity replaces filter: brightness/saturate for iOS compatibility */
  @keyframes crash-shake {
    0%   { transform: translateZ(0) translate(0, 0)       rotate(0deg);    opacity: 1; }
    12%  { transform: translateZ(0) translate(-8px, 4px)  rotate(-1deg);   opacity: 0.2; }
    25%  { transform: translateZ(0) translate(9px, -5px)  rotate(0.8deg);  opacity: 1; }
    38%  { transform: translateZ(0) translate(-7px, 6px)  rotate(-0.6deg); opacity: 0.4; }
    50%  { transform: translateZ(0) translate(8px, -3px)  rotate(0.4deg);  opacity: 0.8; }
    62%  { transform: translateZ(0) translate(-5px, 5px)  rotate(-0.3deg); opacity: 1; }
    75%  { transform: translateZ(0) translate(5px, -4px)  rotate(0.3deg);  opacity: 0.9; }
    88%  { transform: translateZ(0) translate(-3px, 2px)  rotate(0deg);    opacity: 1; }
    100% { transform: translateZ(0) translate(2px, 1px)   rotate(0deg);    opacity: 1; }
  }

  @keyframes post-crash {
    from { opacity: 1; }
    to   { opacity: 0.65; }
  }

  /* Rare, irregular flicker — happens late in the 6s cycle */
  @keyframes broken-idle {
    0%,  82%, 87%, 92%, 100% { opacity: 0.65; }
    84%  { opacity: 0.35; } /* dim flash   */
    89%  { opacity: 0.85; } /* brief surge */
    94%  { opacity: 0.28; } /* deep dim    */
  }

  /* ── Reduced motion: skip directly to broken end state ── */
  @media (prefers-reduced-motion: reduce) {
    .crash-container {
      animation: none;
      transform: translateZ(0) translate(2px, 0);
      opacity: 0.65;
    }
    .p1        { animation: none; stroke-dashoffset: 0; }
    .p1-detail { animation: none; stroke-dashoffset: 0; stroke-opacity: 0.5; }
    .p2        { animation: none; stroke-dashoffset: 54; opacity: 0.6; }
    .p3        { animation: none; stroke-dashoffset: 63; opacity: 0.38; }
    .p4        { animation: none; stroke-dashoffset: 100; opacity: 0; }
  }
</style>
