---
import { dark } from "@eduardoalvarez/arrecife";

import Layout from "../layouts/main/index.astro";

export const prerender = true;

/**
 * El krill se pinta sobre el interior de la boca, que va de `brand-hull` y es el
 * MISMO color en los dos temas. Si el krill siguiera a `--color-accent` se
 * apagaría en claro —medido: 3.60:1 contra los 10.05:1 de oscuro— porque el
 * acento se oscurece con el tema pero la superficie de debajo no.
 *
 * Se fija al acento del tema oscuro, y se toma del propio catálogo de la
 * librería en vez de escribir el hexadecimal a mano.
 */
const KRILL = dark.accent;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content py-24 flex flex-col items-center text-center">

    {/*
      El tiburón ballena es filtrador: come krill. De ahí sale el motivo, y para
      un 404 la escena es que el krill SE ESCAPA — la mascota se queda mirando
      cómo se va lo que venías a buscar.

      Una versión anterior lo contaba al revés, comiendo, y para eso hacía falta
      una boca abierta: la única cara que la tiene es `laughing`, que el catálogo
      reserva para «suscripción confirmada». Una cara de felicidad en una página
      de error no se sostiene. Dándole la vuelta al movimiento, la cara correcta
      es la que el sistema ya mandaba para esto: `confused`, que además trae el
      interrogante dibujado.

      Antes de esto había una aleta que se dibujaba y se rompía a medio trazo, y
      después un intento de dibujar la boca en SVG que salió una cuña geométrica
      plana, sin nada que ver con un sistema hecho de ilustración de trazo grueso.
      La protagonista es el arte de la mascota; lo único dibujado acá es el krill.
    */}
    <div class="escena mb-10" aria-hidden="true">
      <img
        class="mascota"
        src="/brand/face-confused.png"
        alt=""
        width="121"
        height="121"
        loading="eager"
        decoding="async"
      />

      <svg class="krill-scene" viewBox="0 0 260 150" xmlns="http://www.w3.org/2000/svg">
        <g class="krill k1"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k2"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k3"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k4"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
      </svg>
    </div>


    <!-- Error label -->
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent mb-4">404 · aguas desconocidas</p>

    <!-- Heading -->
    <h1 class="text-text-primary mb-3">
      Página no encontrada
    </h1>
    <p class="text-text-secondary text-base sm:text-lg mb-12 max-w-sm">
      Nadaste fuera del mapa. Volvamos a la superficie.
    </p>

    <!-- Destination grid -->
    <div class="w-full grid grid-cols-2 gap-3">
      {
        suggestions.map(({ href, label, description }) => (
          <a
            href={href}
            class="group p-4 text-left rounded-xl border border-border bg-surface hover:border-accent transition-colors duration-200"
          >
            <p class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 mb-1">
              {label}
            </p>
            <p class="text-xs text-text-muted leading-relaxed">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style define:vars={{ krill: KRILL }}>
  /* La cara y el krill comparten caja: el krill se posiciona sobre ella. */
  .escena {
    position: relative;
    width: 260px;
    height: 150px;
  }

  .mascota {
    position: absolute;
    top: 15px;
    left: 0;
    width: 120px;
    height: auto;
    /* Quieta. El interrogante ya está dibujado en la cara y lo que se mueve es
       el krill: si además se moviera ella, competirían. */
  }

  .krill-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .krill path {
    fill: none;
    stroke: var(--krill);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .krill circle {
    fill: var(--krill);
  }

  .krill {
    transform-box: view-box;
    animation: deriva 5.6s linear infinite;
  }

  /* Cada uno sale a su altura y con algo de retraso, para que se escapen en
     fila y no en bloque. La boca de la mascota cae sobre y≈88. */
  .k1 { --y: 84px; animation-delay: 0s; }
  .k2 { --y: 96px; animation-delay: -1.4s; }
  .k3 { --y: 74px; animation-delay: -2.8s; }
  .k4 { --y: 90px; animation-delay: -4.2s; }

  @keyframes deriva {
    /* Sale de delante de la boca y se aleja hacia la derecha, apagándose. */
    0% {
      transform: translate(86px, var(--y));
      opacity: 0;
    }
    14% {
      opacity: 1;
    }
    74% {
      transform: translate(214px, var(--y));
      opacity: 1;
    }
    100% {
      transform: translate(256px, var(--y));
      opacity: 0;
    }
  }

  /* Sin movimiento: la mascota quieta y el krill repartido por el camino.
     Cuenta lo mismo sin animar nada. */
  @media (prefers-reduced-motion: reduce) {
    .krill {
      animation: none;
      opacity: 1;
    }

    .k1 { transform: translate(108px, 84px); }
    .k2 { transform: translate(150px, 96px); }
    .k3 { transform: translate(192px, 74px); }
    .k4 { transform: translate(232px, 90px); }
  }
</style>
