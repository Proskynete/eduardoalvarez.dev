---
import { dark } from "@eduardoalvarez/arrecife";

import Layout from "../layouts/main/index.astro";

export const prerender = true;

/**
 * El krill se pinta sobre el interior de la boca, que va de `brand-hull` y es el
 * MISMO color en los dos temas. Si el krill siguiera a `--color-accent` se
 * apagaría en claro —medido: 3.60:1 contra los 10.05:1 de oscuro— porque el
 * acento se oscurece con el tema pero la superficie de debajo no.
 *
 * Se fija al acento del tema oscuro, y se toma del propio catálogo de la
 * librería en vez de escribir el hexadecimal a mano.
 */
const KRILL = dark.accent;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content py-24 flex flex-col items-center text-center">

    {/*
      El tiburón ballena es filtrador: se alimenta de krill, así que la escena no
      es una licencia gráfica sino lo que el animal hace. Para un 404 encaja
      además con lo que pasó — la página se la tragó algo.

      Antes había una aleta dibujándose que se rompía a medio trazo. Se cambió
      entera: aquella no era la aleta canónica de la marca, y una animación de
      «error de dibujo» compite con el mensaje en vez de acompañarlo.

      La protagonista es la mascota, no un dibujo nuevo. Un intento anterior la
      dibujaba en SVG y salía una cuña geométrica plana que no se parecía en nada
      al sistema, que es ilustración de trazo grueso y formas redondeadas. Lo
      único dibujado acá es el krill.

      El sistema reserva `laughing` para «Éxito, suscripción confirmada» y manda
      `confused` para el 404. Se usa `laughing` a propósito: es la única cara con
      la boca abierta, y sin boca abierta no hay nada que comer. Queda anotado.
    */}
    <div class="escena mb-10" aria-hidden="true">
      <img
        class="mascota"
        src="/brand/face-laughing.png"
        alt=""
        width="121"
        height="121"
        loading="eager"
        decoding="async"
      />

      <svg class="krill-scene" viewBox="0 0 260 150" xmlns="http://www.w3.org/2000/svg">
        <g class="krill k1"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k2"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k3"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k4"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
      </svg>
    </div>


    <!-- Error label -->
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent mb-4">404 · aguas desconocidas</p>

    <!-- Heading -->
    <h1 class="text-text-primary mb-3">
      Página no encontrada
    </h1>
    <p class="text-text-secondary text-base sm:text-lg mb-12 max-w-sm">
      Nadaste fuera del mapa. Volvamos a la superficie.
    </p>

    <!-- Destination grid -->
    <div class="w-full grid grid-cols-2 gap-3">
      {
        suggestions.map(({ href, label, description }) => (
          <a
            href={href}
            class="group p-4 text-left rounded-xl border border-border bg-surface hover:border-accent transition-colors duration-200"
          >
            <p class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 mb-1">
              {label}
            </p>
            <p class="text-xs text-text-muted leading-relaxed">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style define:vars={{ krill: KRILL }}>
  /* La cara y el krill comparten caja: el krill se posiciona sobre ella. */
  .escena {
    position: relative;
    width: 260px;
    height: 150px;
  }

  .mascota {
    position: absolute;
    top: 15px;
    left: 0;
    width: 120px;
    height: auto;
    /* Bocado: un tirón corto al tragar, no un balanceo continuo. Es lo único
       que se mueve de la mascota, y va al compás del krill que llega. */
    animation: bocado 1.6s ease-in-out infinite;
    transform-origin: 50% 70%;
  }

  .krill-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .krill path {
    fill: none;
    stroke: var(--krill);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .krill circle {
    fill: var(--krill);
  }

  .krill {
    transform-box: view-box;
    animation: deriva 6.4s linear infinite;
  }

  /* Cada uno entra a su altura y a un compás de distancia, así llega uno por
     bocado. La boca de la mascota cae sobre y≈88. */
  .k1 { --y: 84px; animation-delay: 0s; }
  .k2 { --y: 94px; animation-delay: -1.6s; }
  .k3 { --y: 78px; animation-delay: -3.2s; }
  .k4 { --y: 90px; animation-delay: -4.8s; }

  @keyframes bocado {
    0%,
    52% {
      transform: scale(1);
    }
    /* El tirón: se encoge un pelo al cerrar y vuelve. */
    64% {
      transform: scale(1.06, 0.95);
    }
    78% {
      transform: scale(0.98, 1.03);
    }
    92%,
    100% {
      transform: scale(1);
    }
  }

  @keyframes deriva {
    /* Entra por la derecha y se apaga en la boca. */
    0% {
      transform: translate(258px, var(--y));
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    88% {
      transform: translate(74px, var(--y));
      opacity: 1;
    }
    100% {
      transform: translate(58px, var(--y));
      opacity: 0;
    }
  }

  /* Sin movimiento: la mascota quieta y el krill repartido por el camino.
     Cuenta lo mismo sin animar nada. */
  @media (prefers-reduced-motion: reduce) {
    .mascota {
      animation: none;
    }

    .krill {
      animation: none;
      opacity: 1;
    }

    .k1 { transform: translate(140px, 84px); }
    .k2 { transform: translate(178px, 94px); }
    .k3 { transform: translate(212px, 78px); }
    .k4 { transform: translate(244px, 90px); }
  }
</style>
