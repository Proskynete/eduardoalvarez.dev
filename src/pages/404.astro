---
import { dark } from "@eduardoalvarez/arrecife";

import Layout from "../layouts/main/index.astro";

export const prerender = true;

/**
 * El krill se pinta sobre el interior de la boca, que va de `brand-hull` y es el
 * MISMO color en los dos temas. Si el krill siguiera a `--color-accent` se
 * apagaría en claro —medido: 3.60:1 contra los 10.05:1 de oscuro— porque el
 * acento se oscurece con el tema pero la superficie de debajo no.
 *
 * Se fija al acento del tema oscuro, y se toma del propio catálogo de la
 * librería en vez de escribir el hexadecimal a mano.
 */
const KRILL = dark.accent;

const suggestions = [
  { href: "/", label: "Inicio", description: "Volver a la página principal" },
  { href: "/articles", label: "Artículos", description: "Lecturas sobre ingeniería y liderazgo" },
  { href: "/speaking", label: "Charlas", description: "Charlas y talleres" },
  { href: "/about", label: "Sobre mí", description: "Quién soy y en qué trabajo" },
];
---

<Layout seo={{ title: "Página no encontrada" }}>
  <div class="mx-auto max-w-content py-24 flex flex-col items-center text-center">

    {/*
      El tiburón ballena es filtrador: se alimenta de krill, así que la escena no
      es una licencia gráfica sino lo que el animal hace. Para un 404 encaja
      además con lo que pasó — la página se la tragó algo.

      Antes había una aleta dibujándose que se rompía a medio trazo. Se cambia
      entera: aquella no era la aleta canónica de la marca, y una animación de
      «error de dibujo» compite con el mensaje en vez de acompañarlo.

      Todo el color sale de tokens. La versión anterior llevaba `#35d6c0` escrito
      seis veces, que es el valor OSCURO del acento: en modo claro se quedaba
      turquesa brillante sobre crema.
    */}
    <div class="mb-10" aria-hidden="true">
      <svg class="krill-scene rounded-panel" width="260" height="150" viewBox="0 0 240 140" xmlns="http://www.w3.org/2000/svg">
        {/* Primer plano de la boca, recortada por los bordes: el sujeto es la
            boca, no el animal entero. Dibujar la cabeza completa a este tamaño
            la convertía en un óvalo azul con un ojo.

            La comisura está a la izquierda (8, 70) y la boca abre hacia la
            derecha, que es por donde entra el krill. La mandíbula de abajo gira
            sobre esa comisura: cerrada sube a juntarse con el labio de arriba,
            abierta cae hasta dejar el hueco entero. */}

        {/* El hueco. Siempre está; lo tapa la mandíbula cuando se cierra. */}
        <path class="interior" d="M8 70 C70 54 160 34 260 26 L260 114 C160 106 70 86 8 70 Z" />

        {/* Mandíbula de arriba, fija. Se extiende fuera del lienzo para que el
            recorte sea del encuadre y no un borde dibujado. */}
        <path class="quijada-sup" d="M-400 -400 H420 V26 C160 34 70 54 8 70 L-400 70 Z" />

        {/* Mandíbula de abajo, la que se mueve. */}
        <path class="quijada-inf" d="M-400 900 L420 900 L420 300 L260 114 C160 106 70 86 8 70 L-400 70 Z" />

        {/* Las manchas van sobre la quijada de arriba, que es la única
            superficie de piel que se ve entera. */}
        <circle class="mancha" cx="34" cy="26" r="4" />
        <circle class="mancha" cx="72" cy="16" r="3.4" />
        <circle class="mancha" cx="104" cy="30" r="3.6" />
        <circle class="mancha" cx="146" cy="14" r="3" />
        <circle class="mancha" cx="182" cy="12" r="2.6" />
        <circle class="mancha" cx="58" cy="42" r="2.8" />

        {/* Cuatro krill, desfasados un segundo — el mismo compás del bocado —
            así entra uno por cada vez que la boca se cierra. */}
        <g class="krill k1"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k2"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k3"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
        <g class="krill k4"><path d="M0 0 c3 -2.6 8 -2.6 11 0" /><circle cx="13.5" cy="0.6" r="1.2" /></g>
      </svg>
    </div>

    <!-- Error label -->
    <p class="font-mono text-xs uppercase tracking-[0.12em] text-accent mb-4">404 · aguas desconocidas</p>

    <!-- Heading -->
    <h1 class="text-text-primary mb-3">
      Página no encontrada
    </h1>
    <p class="text-text-secondary text-base sm:text-lg mb-12 max-w-sm">
      Nadaste fuera del mapa. Volvamos a la superficie.
    </p>

    <!-- Destination grid -->
    <div class="w-full grid grid-cols-2 gap-3">
      {
        suggestions.map(({ href, label, description }) => (
          <a
            href={href}
            class="group p-4 text-left rounded-xl border border-border bg-surface hover:border-accent transition-colors duration-200"
          >
            <p class="text-sm font-semibold text-text-primary group-hover:text-accent transition-colors duration-200 mb-1">
              {label}
            </p>
            <p class="text-xs text-text-muted leading-relaxed">{description}</p>
          </a>
        ))
      }
    </div>
  </div>
</Layout>

<style define:vars={{ krill: KRILL }}>
  /* Todo el color sale de tokens de marca, así que la escena sigue al tema sin
     una sola regla duplicada. La versión anterior llevaba `#35d6c0` escrito seis
     veces —el valor OSCURO del acento— y en claro se quedaba turquesa brillante
     sobre crema. */
  .krill-scene {
    overflow: hidden;
  }

  .quijada-sup,
  .quijada-inf {
    fill: var(--color-brand-body);
  }

  /* El hueco va del color del casco, que es el mismo en los dos temas: por eso
     lee como interior tanto sobre fondo oscuro como sobre crema. */
  .interior {
    fill: var(--color-brand-hull);
  }

  .mancha {
    fill: var(--color-brand-spots);
    opacity: 0.85;
  }

  /* Gira sobre la comisura. Cerrada (-23°) el labio de abajo alcanza al de
     arriba; abierta (0°) deja el hueco entero. */
  .quijada-inf {
    transform-box: view-box;
    transform-origin: 8px 70px;
    animation: bocado 1.6s ease-in-out infinite;
  }

  .krill path {
    fill: none;
    stroke: var(--krill);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .krill circle {
    fill: var(--krill);
  }

  .krill {
    transform-box: view-box;
    animation: deriva 6.4s linear infinite;
  }

  .k1 { --y: 64px; animation-delay: 0s; }
  .k2 { --y: 76px; animation-delay: -1.6s; }
  .k3 { --y: 58px; animation-delay: -3.2s; }
  .k4 { --y: 70px; animation-delay: -4.8s; }

  @keyframes bocado {
    /* Cerrada la mayor parte del ciclo. El bocado es breve a propósito: una boca
       entreabierta todo el rato no se ve tragar. */
    0%,
    46% {
      transform: rotate(-23deg);
    }
    62%,
    74% {
      transform: rotate(0deg);
    }
    92%,
    100% {
      transform: rotate(-23deg);
    }
  }

  @keyframes deriva {
    /* Entra por la derecha y se apaga dentro, ya pasada la comisura. */
    0% {
      transform: translate(236px, var(--y));
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    82% {
      transform: translate(104px, var(--y));
      opacity: 1;
    }
    100% {
      transform: translate(72px, var(--y));
      opacity: 0;
    }
  }

  /* Sin movimiento: la boca se queda abierta a medias y el krill repartido en
     el camino. Cuenta lo mismo sin animar nada. */
  @media (prefers-reduced-motion: reduce) {
    .quijada-inf {
      animation: none;
      transform: rotate(-9deg);
    }

    .krill {
      animation: none;
      opacity: 1;
    }

    .k1 { transform: translate(96px, 64px); }
    .k2 { transform: translate(140px, 76px); }
    .k3 { transform: translate(180px, 58px); }
    .k4 { transform: translate(216px, 70px); }
  }
</style>
