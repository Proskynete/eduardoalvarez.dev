---
import { PageHeader, Separator, Text } from "@eduardoalvarez/arrecife";

import Layout from "../../layouts/main/index.astro";
import Subscribe from "../../components/subscribe/index.astro";
import settings from "../../settings";

export const prerender = true;

const seo = {
  title: "Newsletter sobre desarrollo con IA",
  description: "Artículos sobre Spec-Driven Development y desarrollo con IA, en tu correo.",
};

const valueProps = [
  "Artículos sobre Spec-Driven Development y desarrollo con IA",
  "Perspectivas sobre cómo la IA está cambiando el trabajo de los equipos técnicos",
  "Lo que hice, lo que me salió mal y lo que aprendimos con mi equipo",
  "Sin spam. Puedes darte de baja cuando quieras.",
];
---

<Layout seo={seo}>
  <div class="mx-auto max-w-wide">
    {/* La misma cabecera del sistema que ya usan /articles, /about y /speaking.
        Lo que había aquí la reescribía con `text-[12.5px]`, `clamp(...)` y
        `max-w-[62ch]` a mano. */}
    <PageHeader
      eyebrow="/newsletter"
      title="Newsletter"
      description="Artículos sobre Spec-Driven Development y desarrollo con IA, directamente en tu correo."
    />

    <div class="gap-step-md mb-step-xl flex flex-col">
      <Text variant="body" tone="secondary">
        Una edición mensual con ensayos originales sobre cómo los equipos de ingeniería están evolucionando en la era
        de la IA, reflexiones sobre liderazgo técnico y recomendaciones de lectura. Dirigida a Staff Engineers,
        Engineering Managers y Tech Leads que quieren profundidad, no titulares. Sin spam, cancelas cuando quieras.
      </Text>
      <Text variant="label" tone="muted" as="p" className="font-normal">
        {settings.authorInlineBio.text}{" "}
        <a href={settings.authorInlineBio.href} class="text-accent underline">{settings.authorInlineBio.cta}</a>
      </Text>

      <ul class="gap-step-sm flex flex-col">
        {
          valueProps.map((prop) => (
            <li class="gap-step-sm flex items-start">
              <span class="text-accent mt-1 shrink-0" aria-hidden="true">✓</span>
              <Text variant="ui" tone="secondary" as="span">{prop}</Text>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Subscribe: rompe el contenedor de lectura porque es un panel de dos
         columnas y a 760px la rejilla se ahoga. -->
    <Subscribe />

    <!-- Archive placeholder -->
    <Separator className="mt-step-xl" />
    <section class="pt-step-xl">
      <Text as="h2" variant="h3" className="mb-step-sm">Archivo</Text>
      <Text variant="label" tone="secondary" as="p" className="font-normal">
        El archivo de ediciones anteriores estará disponible próximamente.
      </Text>
    </section>
  </div>
</Layout>
