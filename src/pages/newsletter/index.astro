---
import { PageHeader } from "@eduardoalvarez/arrecife";
import Layout from "../../layouts/main/index.astro";
import Subscribe from "../../components/subscribe/index.astro";
import settings from "../../settings";

export const prerender = true;

const seo = {
  title: "Newsletter de liderazgo de ingeniería e IA",
  description: "Artículos sobre liderazgo de ingeniería, arquitectura de plataformas y la era de la IA — en tu correo.",
};

const valueProps = [
  "Artículos sobre liderazgo de ingeniería y arquitectura de plataforma",
  "Perspectivas sobre cómo la IA está cambiando el trabajo de los equipos técnicos",
  "Reflexiones desde la práctica — no teoría de libro, sino lo que funciona en organizaciones reales",
  "Sin spam. Puedes darte de baja cuando quieras.",
];
---

<Layout seo={seo}>
  <div class="mx-auto max-w-wide">
    <!-- Page header -->
      <PageHeader
        eyebrow="/newsletter"
        title="Newsletter"
        description="Una edición mensual sobre cómo los equipos de ingeniería evolucionan en la era de la IA, liderazgo técnico y recomendaciones de lectura. Para quienes quieren profundidad, no titulares. Sin spam."
      />

    <!-- Value proposition -->
    <section class="mb-10">
      <ul class="space-y-3">
        {
          valueProps.map((prop) => (
            <li class="flex gap-3 text-text-secondary leading-relaxed">
              <span class="text-accent shrink-0 mt-1">✓</span>
              {prop}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Subscribe: rompe el contenedor de lectura porque es un panel de dos
         columnas y a 760px la rejilla se ahoga. -->
    <Subscribe />

    <!-- Archive placeholder -->
    <section class="mt-16 border-t border-border pt-10">
      <h2 class="text-xl font-bold text-text-primary mb-4">Archivo</h2>
      <p class="text-text-muted text-sm">El archivo de ediciones anteriores estará disponible próximamente.</p>
    </section>
  </div>
</Layout>
