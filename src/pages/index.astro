---
import { TalkCard, buttonVariants } from "@eduardoalvarez/arrecife";

import type { Article as IArticle } from "../interfaces";
import Layout from "../layouts/main/index.astro";
import Article from "../components/article/index.astro";
import TextLink from "../components/text-link/index.astro";
import Subscribe from "../components/subscribe/index.astro";
import { talks } from "../settings/talks";
import type { Talk } from "../settings/talks";
import { articlesSort } from "../utils/articles";
import settings from "../settings";

export const prerender = true;

interface Post {
  frontmatter: IArticle;
}

const _MAX_ARTICLES = 3;
const rawPosts = import.meta.glob<{ frontmatter: IArticle }>("./articles/*.mdx", { eager: true });
const posts: Post[] = Object.values(rawPosts);
posts.sort(articlesSort).splice(_MAX_ARTICLES);

const featuredTalks = talks.filter((t: Talk) => t.show).slice(0, 3);

const githubLink = settings.social_network.find((s) => s.name === "Github")?.link ?? "";
const linkedinLink = settings.social_network.find((s) => s.name === "LinkedIn")?.link ?? "";
const twitterLink = settings.contacts.find((c) => c.name === "Twitter")?.href ?? "";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: settings.title,
      url: settings.url,
      potentialAction: {
        "@type": "SearchAction",
        target: `${settings.url}/articles?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Person",
      name: settings.author.name,
      url: settings.url,
      email: settings.email,
      jobTitle: "Engineering Leader",
      sameAs: [githubLink, linkedinLink, twitterLink].filter(Boolean),
    },
  ],
};

const seo = {
  title: "Eduardo Álvarez — Engineering Leadership & Platform Thinking",
  description: "Engineering Leadership & Platform Thinking in the AI Era.",
  schema,
};
---

<Layout seo={seo}>
  <!-- Hero -->
  {/* Hero. No wrapper: the mascot floats free instead of sitting inside a
      gradient panel, so the page opens on the character and not on a box. */}
  <section aria-label="Introduction" class="mb-20 pt-6 sm:pt-10">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16">
      <div>
        <p class="mb-4 font-mono text-[11.5px] uppercase tracking-[0.12em] text-accent">
          Engineering Leadership &amp; Platform Thinking
        </p>
        <h1
          class="mb-[18px] font-display text-[clamp(2.6rem,6.4vw,64px)] font-extrabold leading-[0.96] tracking-[-0.035em] text-text-primary"
        >
          Eduardo<br />Álvarez
        </h1>
        <p class="mb-[14px] max-w-[52ch] text-base leading-relaxed text-text-secondary">
          Ayudo a equipos de ingeniería a escalar con criterio — desde la arquitectura de plataforma hasta la cultura de
          liderazgo técnico en la era de la IA.
        </p>
        <p class="mb-[26px] max-w-[62ch] text-sm leading-relaxed text-text-secondary">
          Este sitio reúne mis artículos sobre liderazgo técnico, arquitectura de plataformas y el impacto de la IA en
          los equipos de software. También encontrarás un resumen de mis charlas, los servicios de consultoría y
          mentoring que ofrezco, y la newsletter mensual donde profundizo en estos temas sin spam.
        </p>
        <div class="flex flex-wrap gap-4">
          {/* `buttonVariants` en vez de `<Button asChild>`: esto son dos enlaces
              estáticos y montar una isla de React para pintarlos sería pagar
              hidratación por nada. La CVA se evalúa al construir. */}
          <a href="/articles" class={buttonVariants({ variant: "primary" })}>Leer artículos</a>
          <a href="/about" class={buttonVariants({ variant: "secondary" })}>Sobre mí</a>
        </div>
      </div>

      {/* Centred and floating. The animation is a slow vertical drift — it
          reads as buoyancy, not as a bounce. Disabled under reduced motion. */}
      <div class="order-first flex justify-center lg:order-none">
        <img
          data-testid="hero-mascot"
          src="/brand/pose-laptop-coffee.png"
          alt=""
          aria-hidden="true"
          width="346"
          height="276"
          fetchpriority="high"
          decoding="async"
          class="w-[260px] max-w-full select-none motion-safe:animate-float sm:w-[300px] lg:w-full"
        />
      </div>
    </div>
  </section>

  <!-- Latest Writing -->
  <section aria-label="Últimos artículos" class="mb-20 mx-auto max-w-full">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-text-primary">Últimos artículos</h2>
      <TextLink href="/articles">./ver_todos</TextLink>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {posts.map(({ frontmatter }) => <Article article={frontmatter} />)}
    </div>
  </section>

  <!-- Recent Speaking -->
  {
    featuredTalks.length > 0 && (
      <section aria-label="Charlas recientes" class="mb-20 mx-auto max-w-full">
        <div class="flex items-center justify-between mb-8">
          <h2 class="text-text-primary">Charlas recientes</h2>
          <TextLink href="/speaking">./ver_todas</TextLink>
        </div>
        <div class="gap-step-md grid sm:grid-cols-2">
          {featuredTalks.map((talk: Talk) => (
            <TalkCard
              href={talk.options?.presentation ?? talk.options?.repo ?? talk.location.url}
              target="_blank"
              rel="noopener noreferrer"
              title={talk.title}
              event={talk.organizations[0]?.name ?? talk.location.name}
              date={new Date(talk.date[0]).toLocaleDateString("es-CL", { year: "numeric", month: "long" })}
              dateTime={talk.date[0]}
              location={talk.location.name}
              description={talk.description}
              className="h-full"
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Newsletter CTA -->
  <Subscribe />
</Layout>
