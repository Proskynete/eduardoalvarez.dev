---
import { Badge, Card, CardContent, CardFooter, EmptyState, PageHeader, Text, buttonVariants } from "@eduardoalvarez/arrecife";
import { Image } from "astro:assets";

import { Icon } from "../../assets/icons";
import AudioPlayer from "../../components/audio-player/index";
import PodcastGuest from "../../components/podcast-guest/index";
import Layout from "../../layouts/main/index.astro";
import { platformIcons, podcasts } from "../../settings/podcasts";
import type { PodcastEpisode } from "../../settings/podcasts";

export const prerender = true;

const seo = {
  title: "Podcasts",
  description: "Episodios de podcast donde conversamos sobre desarrollo web, tecnología y carrera profesional.",
  image: "/images/podcasts/podcasts-cover.webp",
};

function formatDuration(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0) {
    return `${hours}h ${mins}min`;
  }
  return `${mins} min`;
}

const visible = podcasts.filter((podcast: PodcastEpisode) => podcast.show);
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full">
    {/* La misma cabecera del sistema que el resto de las secciones. */}
    <PageHeader
      eyebrow="/podcasts"
      title="Podcasts"
      description="Conversaciones sobre desarrollo web, tecnología y carrera profesional con invitados de la industria."
    />

    {
      visible.length === 0 ? (
        /* `EmptyState` en vez de dos párrafos centrados: la sección vacía es
           una pantalla, así que lleva cara — `waiting`, que es la que el
           catálogo asigna a «todavía no hay nada». */
        <EmptyState
          variant="page"
          expression="waiting"
          title="No hay episodios disponibles"
          description="Vuelve pronto para ver nuevo contenido."
        />
      ) : (
        <div class="gap-step-md grid grid-cols-1">
          {visible.map((podcast: PodcastEpisode) => (
            <Card className="overflow-hidden">
              {/* Cabecera del episodio con imagen de fondo */}
              <a
                href={`/podcasts/${podcast.slug}`}
                class="group from-background to-surface focus-ring relative block h-48 overflow-hidden bg-gradient-to-br md:h-56"
              >
                {podcast.image && (
                  <Image
                    src={podcast.image}
                    alt={podcast.title}
                    class="h-full w-full object-cover opacity-40 transition-opacity duration-200 group-hover:opacity-50"
                    width={800}
                    height={400}
                    widths={[400, 800]}
                    sizes="(max-width: 768px) 100vw, 800px"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                )}

                {/*
                  El velo es negro en los dos temas, así que el texto que va
                  encima se fija en blanco. Es el mismo caso que la portada del
                  episodio: no hay token para «sobre una foto oscurecida».
                */}
                <div class="p-step-md absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/50 to-transparent">
                  <div class="gap-step-sm mb-step-xs flex items-center">
                    <Badge variant="neutral" className="border border-white/25 bg-white/15 text-white">
                      Episodio {podcast.episode}
                    </Badge>
                    <Text variant="label" as="span" className="text-white/80">
                      {formatDuration(podcast.duration)}
                    </Text>
                  </div>
                  <Text as="h2" variant="h3" className="group-hover:text-accent transition-standard line-clamp-2 text-white">
                    {podcast.title}
                  </Text>
                </div>
              </a>

              <CardContent className="gap-step-md pt-step-md flex flex-col">
                <AudioPlayer client:visible src={podcast.audioUrl} />

                <div class="gap-step-xs flex flex-col">
                  <time datetime={podcast.date}>
                    <Text variant="meta" tone="muted" as="span">
                      {new Date(podcast.date).toLocaleDateString("es-ES", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </Text>
                  </time>
                  <Text variant="ui" tone="secondary" className="line-clamp-3">
                    {podcast.description}
                  </Text>
                </div>

                {podcast.guests.length > 0 && (
                  <div class="gap-step-sm flex flex-col">
                    <Text as="h3" variant="label" tone="secondary" className="font-medium">
                      {podcast.guests.length === 1 ? "Invitado" : "Invitados"}
                    </Text>
                    <div class="gap-step-sm grid sm:grid-cols-2">
                      {podcast.guests.map((guest) => (
                        <PodcastGuest
                          name={guest.name}
                          role={guest.role}
                          company={guest.company}
                          linkedin={guest.linkedin}
                          twitter={guest.twitter}
                        />
                      ))}
                    </div>
                  </div>
                )}

                {/* `Badge` del sistema. Antes cada tema traía `px-2 py-1 text-xs
                    rounded-md border` escrito encima de la variante, que peleaba
                    con el tamaño y el radio que la variante ya define. */}
                <div class="gap-step-xs flex flex-wrap">
                  {podcast.topics.map((topic) => (
                    <Badge variant="neutral">{topic.name}</Badge>
                  ))}
                </div>
              </CardContent>

              <CardFooter className="flex-col items-stretch sm:flex-row sm:items-center sm:justify-between">
                <div class="gap-step-sm flex flex-1 flex-col">
                  <Text as="h3" variant="label" tone="secondary" className="font-medium">
                    Escuchar en
                  </Text>
                  <div class="gap-step-xs flex flex-wrap">
                    {podcast.platforms.map((platform) => (
                      <a
                        href={platform.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={buttonVariants({ variant: "secondary", size: "sm" })}
                        aria-label={`Escuchar en ${platform.name}`}
                      >
                        <Icon.Platform path={platformIcons[platform.icon]} className="h-4 w-4" />
                        {platform.name}
                      </a>
                    ))}
                  </div>
                </div>

                <a
                  href={`/podcasts/${podcast.slug}`}
                  class={buttonVariants({ variant: "primary" })}
                >
                  <span>Ver episodio</span>
                  <Icon.ChevronRight className="h-4 w-4" />
                </a>
              </CardFooter>
            </Card>
          ))}
        </div>
      )
    }
  </div>
</Layout>
