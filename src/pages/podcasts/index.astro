---
import { EmptyState, PageHeader, Text } from "@eduardoalvarez/arrecife";

import PodcastRow from "../../components/podcast-row/index.astro";
import Layout from "../../layouts/main/index.astro";
import { podcasts } from "../../settings/podcasts";
import type { PodcastEpisode } from "../../settings/podcasts";
import { formatDuration, groupByYear, totalDuration } from "../../utils/podcasts";

export const prerender = true;

const seo = {
  title: "Podcasts",
  description: "Episodios de podcast donde conversamos sobre desarrollo web, tecnología y carrera profesional.",
  image: "/images/podcasts/podcasts-cover.webp",
};

const visible = podcasts.filter((podcast: PodcastEpisode) => podcast.show);
const years = groupByYear(visible);

/**
 * La línea de la cabecera: cuántos episodios hay y cuánto duran juntos.
 *
 * Es el dato que convierte cinco cosas sueltas en un cuerpo de trabajo, y se
 * deriva entero de los episodios — nadie lo mantiene a mano. Va como una sola
 * cadena porque `compressHTML` colapsa el espacio entre expresiones adyacentes.
 */
const count = visible.length;
const summary = `${count} ${count === 1 ? "episodio" : "episodios"} · ${formatDuration(totalDuration(visible))}`;

/** El más reciente del grupo más reciente, que es el único que lleva marca. */
const latestSlug = years[0]?.episodes[0]?.slug;
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full">
    {/* La misma cabecera del sistema que el resto de las secciones. */}
    <PageHeader
      eyebrow="/podcasts"
      title="Podcasts"
      description="Conversaciones sobre desarrollo web, tecnología y carrera profesional con invitados de la industria."
    />

    {
      visible.length === 0 ? (
        /* `EmptyState` en vez de dos párrafos centrados: la sección vacía es
           una pantalla, así que lleva cara — `waiting`, que es la que el
           catálogo asigna a «todavía no hay nada». */
        <EmptyState
          variant="page"
          expression="waiting"
          title="No hay episodios disponibles"
          description="Vuelve pronto para ver nuevo contenido."
        />
      ) : (
        <div class="gap-step-xl flex flex-col">
          <Text variant="meta" tone="muted" as="p">
            {summary}
          </Text>

          {/*
            Agrupados por año, que es como `/speaking` ordena las charlas.

            El listado dejó de ser cinco páginas de detalle apiladas: el
            reproductor, los invitados, las plataformas y los tags viven en
            `/podcasts/[slug]`, que es la página que existía para eso y no
            tenía nada que hacer. De paso, esta página dejó de hidratar un
            `AudioPlayer` por episodio y ya no monta React en el cliente.
          */}
          {years.map(({ year, episodes }) => (
            <section class="gap-step-md flex flex-col" aria-labelledby={`year-${year}`}>
              <div class="gap-step-md flex items-center">
                <Text as="h2" variant="eyebrow" tone="muted" id={`year-${year}`} className="shrink-0">
                  {year}
                </Text>
                <span class="border-hairline h-px flex-1 border-t" aria-hidden="true" />
              </div>

              <div class="gap-step-sm flex flex-col">
                {episodes.map((episode) => (
                  <PodcastRow episode={episode} latest={episode.slug === latestSlug} />
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</Layout>
