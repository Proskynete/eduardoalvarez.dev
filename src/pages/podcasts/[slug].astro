---
import { Badge, Breadcrumb, Card, CardContent, CardHeader, CardTitle, Separator, Text, buttonVariants } from "@eduardoalvarez/arrecife";
import { Icon } from "@eduardoalvarez/arrecife/icons";
import { ArrowLeft, LinkedinLogo, XLogo } from "@phosphor-icons/react";
import { Image } from "astro:assets";
import { marked } from "marked";

import AudioPlayer from "../../components/audio-player/index";
import PodcastGuest from "../../components/podcast-guest/index";
import Layout from "../../layouts/main/index.astro";
import { platformIcons, podcasts } from "../../settings/podcasts";
import type { PodcastEpisode } from "../../settings/podcasts";

export const prerender = true;

export function getStaticPaths() {
  return podcasts
    .filter((podcast) => podcast.show)
    .map((podcast) => ({
      params: { slug: podcast.slug },
      props: { podcast },
    }));
}

interface Props {
  podcast: PodcastEpisode;
}

const { podcast } = Astro.props;

const contentHtml = await marked(podcast.content);

const seo = {
  title: `${podcast.title} | Podcast`,
  description: podcast.description,
  image: "/images/podcasts/podcasts-cover.webp",
};

function formatDuration(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0) {
    return `${hours}h ${mins}min`;
  }
  return `${mins} min`;
}

const episodeUrl = `https://eduardoalvarez.dev/podcasts/${podcast.slug}`;
const shareLinks = [
  {
    label: "X",
    href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(podcast.title)}&url=${encodeURIComponent(episodeUrl)}`,
  },
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(episodeUrl)}&title=${encodeURIComponent(podcast.title)}`,
  },
];
---

<Layout seo={seo}>
  <article class="mx-auto max-w-full">
    {/*
      The library's Breadcrumb replaces the hand-built ol. It leads with `~`
      rather than the word "Inicio" — the same terminal voice the nav uses — and
      marks the last item as the current page instead of leaving it an
      unlabelled li.
    */}
    <Breadcrumb
      className="mb-step-md"
      homeHref="/"
      homeLabel="Inicio"
      items={[{ label: "Podcasts", href: "/podcasts" }, { label: podcast.title }]}
    />

    {/* Header del episodio */}
    <header class="mb-step-xl">
      <div class="rounded-panel from-background to-surface mb-step-md relative h-64 overflow-hidden bg-gradient-to-br md:h-80">
        {
          podcast.image && (
            <Image
              src={podcast.image}
              alt={podcast.title}
              class="h-full w-full object-cover opacity-40"
              width={1200}
              height={600}
              widths={[600, 1200]}
              sizes="(max-width: 768px) 100vw, 1200px"
              format="webp"
              loading="eager"
              decoding="async"
            />
          )
        }

        <div class="p-step-lg absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-black/90 via-black/50 to-transparent">
          {/* El velo es negro en los dos temas, así que el texto que va encima
              se fija en blanco. Seguía a `text-primary` y en claro salía oscuro
              sobre oscuro: el título del episodio no se leía. */}
          <div class="gap-step-sm mb-step-sm flex items-center">
            <Badge variant="neutral" className="border border-white/25 bg-white/15 text-white">
              Episodio {podcast.episode}
            </Badge>
            <Text variant="ui" as="span" className="text-white/80">{formatDuration(podcast.duration)}</Text>
          </div>
          <h1 class="text-white">{podcast.title}</h1>
          <time datetime={podcast.date} class="mt-step-xs">
            <Text variant="meta" as="span" className="text-white/80">
              {
                new Date(podcast.date).toLocaleDateString("es-ES", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })
              }
            </Text>
          </time>
        </div>
      </div>

      {/* Reproductor de audio destacado */}
      <Card>
        <CardHeader>
          <CardTitle>Escuchar episodio</CardTitle>
        </CardHeader>
        <CardContent>
          <AudioPlayer client:load src={podcast.audioUrl} title={podcast.title} />
        </CardContent>
      </Card>
    </header>

    {/* Contenido principal en dos columnas */}
    <div class="gap-step-lg flex flex-col lg:flex-row">
      {/* Columna principal: contenido */}
      <div class="flex-1">
        <section class="mb-step-xl">
          <Text as="h2" variant="h3" className="mb-step-sm">Sobre este episodio</Text>
          <Text variant="body" tone="secondary">{podcast.description}</Text>
        </section>

        <section class="mb-step-xl">
          <Text as="h2" variant="h3" className="mb-step-sm">Temas tratados</Text>
          <div class="gap-step-xs flex flex-wrap">
            {podcast.topics.map((topic) => <Badge variant="neutral">{topic.name}</Badge>)}
          </div>
        </section>

        <section class="mb-step-xl">
          <Text as="h2" variant="h3" className="mb-step-sm">Notas del episodio</Text>
          <div
            class="prose max-w-none
                   prose-a:text-accent prose-a:no-underline hover:prose-a:text-accent-hover
                   prose-li:marker:text-accent
                   prose-blockquote:border-accent
                   prose-code:text-accent prose-code:bg-surface-raised
                   prose-pre:bg-brand-hull"
            set:html={contentHtml}
          />
        </section>
      </div>

      {/* Sidebar */}
      <aside class="gap-step-md flex shrink-0 flex-col lg:w-80">
        {
          podcast.guests.length > 0 && (
            <section class="gap-step-sm flex flex-col">
              <Text as="h2" variant="h3">
                {podcast.guests.length === 1 ? "Invitado" : "Invitados"}
              </Text>
              {podcast.guests.map((guest) => (
                <PodcastGuest
                  name={guest.name}
                  role={guest.role}
                  company={guest.company}
                  linkedin={guest.linkedin}
                  twitter={guest.twitter}
                />
              ))}
            </section>
          )
        }

        {/* Plataformas y compartir: dos tarjetas del sistema en vez de
            `bg-surface rounded-xl p-6 border border-border` escrito tres veces
            en este archivo. */}
        <Card>
          <CardHeader>
            <CardTitle>Escuchar en</CardTitle>
          </CardHeader>
          <CardContent className="gap-step-xs flex flex-col">
            {
              podcast.platforms.map((platform) => (
                <a
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${buttonVariants({ variant: "secondary" })} justify-start`}
                >
                  <Icon as={platformIcons[platform.icon]} />
                  {platform.name}
                </a>
              ))
            }
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Compartir</CardTitle>
          </CardHeader>
          <CardContent className="gap-step-xs flex">
            {
              shareLinks.map(({ label, href }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${buttonVariants({ variant: "secondary" })} flex-1`}
                  aria-label={`Compartir en ${label}`}
                >
                  <Icon as={label === "X" ? XLogo : LinkedinLogo} />
                </a>
              ))
            }
          </CardContent>
        </Card>
      </aside>
    </div>

    {/* Volver a podcasts */}
    <Separator className="mt-step-xl" />
    <div class="pt-step-lg">
      <a href="/podcasts" class={buttonVariants({ variant: "tertiary" })}>
        <Icon as={ArrowLeft} />
        Volver a todos los episodios
      </a>
    </div>
  </article>
</Layout>
