---
import { Badge, Breadcrumb, Card, CardContent, CardHeader, CardTitle, Separator, Text, buttonVariants } from "@eduardoalvarez/arrecife";
import { Icon } from "@eduardoalvarez/arrecife/icons";
import { ArrowLeft, LinkedinLogo, XLogo } from "@phosphor-icons/react";
import { Image } from "astro:assets";
import { marked } from "marked";

import AudioPlayer from "../../components/audio-player/index";
import PodcastGuest from "../../components/podcast-guest/index";
import Layout from "../../layouts/main/index.astro";
import { platformIcons, podcasts } from "../../settings/podcasts";
import type { PodcastEpisode } from "../../settings/podcasts";
import { formatDuration, formatGuests } from "../../utils/podcasts";

export const prerender = true;

export function getStaticPaths() {
  return podcasts
    .filter((podcast) => podcast.show)
    .map((podcast) => ({
      params: { slug: podcast.slug },
      props: { podcast },
    }));
}

interface Props {
  podcast: PodcastEpisode;
}

const { podcast } = Astro.props;

const contentHtml = await marked(podcast.content);

const seo = {
  title: `${podcast.title} | Podcast`,
  description: podcast.description,
  image: "/images/podcasts/podcasts-cover.webp",
};

const prettyDate = new Date(podcast.date).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/**
 * La meta va como UNA cadena: `compressHTML` colapsa el espacio entre dos
 * expresiones adyacentes. Los segmentos se filtran antes de unirse para que un
 * episodio sin invitados no arrastre un `·` suelto.
 */
const meta = [prettyDate, formatDuration(podcast.duration), formatGuests(podcast.guests)].filter(Boolean).join(" · ");

const episodeUrl = `https://eduardoalvarez.dev/podcasts/${podcast.slug}`;
const shareLinks = [
  {
    label: "X",
    href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(podcast.title)}&url=${encodeURIComponent(episodeUrl)}`,
  },
  {
    label: "LinkedIn",
    href: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(episodeUrl)}&title=${encodeURIComponent(podcast.title)}`,
  },
];
---

<Layout seo={seo}>
  <article class="mx-auto max-w-full">
    {/*
      The library's Breadcrumb replaces the hand-built ol. It leads with `~`
      rather than the word "Inicio" — the same terminal voice the nav uses — and
      marks the last item as the current page instead of leaving it an
      unlabelled li.
    */}
    <Breadcrumb
      className="mb-step-md"
      homeHref="/"
      homeLabel="Inicio"
      items={[{ label: "Podcasts", href: "/podcasts" }, { label: podcast.title }]}
    />

    {/*
      La cabecera es texto sobre la superficie de la página.

      Era una banda de 256px en móvil y 320 en escritorio, degradado de
      `background` a `surface` con un velo negro encima y el título dentro, a la
      espera de una portada que ningún episodio tiene. El índice ya se deshizo
      de ese mismo hueco; dos vistas de la misma sección no pueden responder de
      forma opuesta al mismo dato ausente.

      Con el velo se fue la única excepción de color del archivo: el título
      estaba fijado a blanco porque el degradado era negro en los dos temas, y
      ahora vuelve a seguir el tema como todo lo demás.
    */}
    <header class="gap-step-lg mb-step-lg flex flex-col sm:flex-row sm:items-start">
      {
        podcast.image && (
          <Image
            src={podcast.image}
            alt={`Portada del episodio ${podcast.episode}`}
            class="rounded-card border-hairline w-full max-w-56 shrink-0 border object-cover"
            width={448}
            height={448}
            widths={[224, 448]}
            sizes="(max-width: 640px) 100vw, 224px"
            format="webp"
            loading="eager"
            decoding="async"
          />
        )
      }

      <div class="gap-step-sm flex min-w-0 flex-col">
        <div class="gap-step-sm flex flex-wrap items-center">
          <Badge variant="accent">Episodio {podcast.episode}</Badge>
          <Text variant="meta" tone="muted" as="span">
            <time datetime={podcast.date}>{prettyDate}</time>{meta.slice(prettyDate.length)}
          </Text>
        </div>

        <h1 class="text-text-primary">{podcast.title}</h1>

        {/*
          Los temas eran una sección con `h2` —al mismo nivel que las notas del
          episodio— para pintar tres badges. Son metadatos del episodio, así que
          viven donde el resto de sus metadatos.
        */}
        {
          podcast.topics.length > 0 && (
            <div class="gap-step-xs flex flex-wrap">
              {podcast.topics.map((topic) => (
                <Badge variant="neutral">{topic.name}</Badge>
              ))}
            </div>
          )
        }
      </div>
    </header>

    {/*
      El reproductor, desnudo.

      Iba dentro de una `Card` con el encabezado «Escuchar episodio»: una
      tarjeta y un título para un control que tiene un botón de play. Costaba
      unos 90px antes de poder pulsarlo y repetía el título del episodio, que
      ya está en el breadcrumb y en el `<h1>` a doscientos píxeles de ahí — tres
      veces en la primera pantalla.
    */}
    <AudioPlayer client:load src={podcast.audioUrl} />

    {/*
      Dos órdenes de lectura, un solo árbol en el DOM.

      En móvil los invitados suben entre el reproductor y el cuerpo: es un
      podcast de entrevistas, quién habla es contenido y no metadato, y estaba a
      más de tres pantallas de scroll, detrás de las notas completas. Las
      acciones —dónde escuchar, compartir— se quedan al final, que es cuando se
      usan. En `lg` el raíl vuelve a la derecha con los tres bloques.
    */}
    <div class="gap-step-lg mt-step-xl flex flex-col lg:grid lg:grid-cols-[1fr_20rem] lg:items-start">
      {
        podcast.guests.length > 0 && (
          <section class="gap-step-sm order-1 flex flex-col lg:col-start-2 lg:row-start-1">
            <Text as="h2" variant="h3">
              {podcast.guests.length === 1 ? "Invitado" : "Invitados"}
            </Text>
            {podcast.guests.map((guest) => (
              <PodcastGuest
                name={guest.name}
                role={guest.role}
                company={guest.company}
                linkedin={guest.linkedin}
                twitter={guest.twitter}
              />
            ))}
          </section>
        )
      }

      <div class="order-2 min-w-0 lg:col-start-1 lg:row-span-2 lg:row-start-1">
        <section class="mb-step-xl">
          <Text as="h2" variant="h3" className="mb-step-sm">Sobre este episodio</Text>
          <Text variant="body" tone="secondary">{podcast.description}</Text>
        </section>

        <section>
          <Text as="h2" variant="h3" className="mb-step-sm">Notas del episodio</Text>
          <div
            class="prose max-w-none
                   prose-a:text-accent prose-a:no-underline hover:prose-a:text-accent-hover
                   prose-li:marker:text-accent
                   prose-blockquote:border-accent
                   prose-code:text-accent prose-code:bg-surface-raised
                   prose-pre:bg-brand-hull"
            set:html={contentHtml}
          />
        </section>
      </div>

      {/*
        El aside se queda con lo que de verdad es complementario. Los invitados
        salieron de aquí: en un podcast de entrevistas son contenido, y en móvil
        este bloque caía detrás de las notas completas, a más de tres pantallas.

        En móvil el contenedor es una columna flex y manda `order`: invitados,
        cuerpo, acciones. En `lg` es una rejilla de dos columnas y el cuerpo
        ocupa las dos filas de la izquierda, así que el raíl vuelve a la derecha
        con los invitados arriba y las acciones debajo. Un solo árbol en el DOM
        en ambos casos.
      */}
      <aside
        class="gap-step-md order-3 flex shrink-0 flex-col lg:col-start-2 lg:row-start-2"
        aria-label="Escuchar y compartir"
      >
        <Card>
          <CardHeader>
            <CardTitle>Escuchar en</CardTitle>
          </CardHeader>
          <CardContent className="gap-step-xs flex flex-col">
            {
              podcast.platforms.map((platform) => (
                <a
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${buttonVariants({ variant: "secondary" })} justify-start`}
                >
                  <Icon as={platformIcons[platform.icon]} />
                  {platform.name}
                </a>
              ))
            }
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Compartir</CardTitle>
          </CardHeader>
          <CardContent className="gap-step-xs flex">
            {
              shareLinks.map(({ label, href }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`${buttonVariants({ variant: "secondary" })} flex-1`}
                  aria-label={`Compartir en ${label}`}
                >
                  <Icon as={label === "X" ? XLogo : LinkedinLogo} />
                </a>
              ))
            }
          </CardContent>
        </Card>
      </aside>
    </div>

    {/* Volver a podcasts */}
    <Separator className="mt-step-xl" />
    <div class="pt-step-lg">
      <a href="/podcasts" class={buttonVariants({ variant: "tertiary" })}>
        <Icon as={ArrowLeft} />
        Volver a todos los episodios
      </a>
    </div>
  </article>
</Layout>
