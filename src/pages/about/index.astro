---
import {
  Blockquote,
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
  PageHeader,
  Text,
  buttonVariants,
} from "@eduardoalvarez/arrecife";

import Layout from "../../layouts/main/index.astro";
import { experience } from "../../settings/about";
import { nowItems, lastUpdated } from "../../settings/now";
import type { NowItem } from "../../settings/now";
import settings from "../../settings";
import { personSchema } from "../../utils/person-schema";

export const prerender = true;

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: `${settings.url}/about`,
  mainEntity: personSchema,
};

const seo = {
  title: "Sobre mí — Technical Lead · Spec-Driven Development",
  description:
    "Llevo más de diez años construyendo aplicaciones web y hoy lidero un equipo de desarrollo. Doy charlas, talleres y cursos, muchos de ellos gratis.",
  schema,
};

const nowCategories = [...new Set(nowItems.map((item: NowItem) => item.category))];
const nowByCategory = Object.fromEntries(
  nowCategories.map((cat) => [cat, nowItems.filter((item: NowItem) => item.category === cat)]),
);

const formattedDate = new Date(lastUpdated).toLocaleDateString("es-CL", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full space-y-16">
    {/* La cabecera es la misma que el resto de las secciones del sitio. */}
    <section class="flex flex-col-reverse sm:flex-row items-start gap-10 sm:gap-16">
      <div class="flex-1">
        <PageHeader
          eyebrow="./sobre_mí"
          title="Hola, soy Eduardo"
          description="Llevo más de diez años construyendo aplicaciones web y hoy lidero un equipo de desarrollo. Me interesa cómo usamos la IA sin dejar de entender lo que construimos, y por eso trabajo con Spec-Driven Development. Doy charlas, talleres y cursos, muchos de ellos gratis."
          className="py-0"
        />
        <Text variant="body" tone="secondary" className="mt-step-md">
          Mi primera computadora tenía Windows 95 y desde ahí quise entender cómo se hacían las cosas que veía en la
          pantalla. Esa curiosidad me llevó a estudiar programación, a trabajar años en frontend y después a liderar
          equipos. Este sitio es donde comparto lo que voy aprendiendo en el camino.
        </Text>
      </div>

      <div class="w-48 sm:w-64 shrink-0">
        <img
          src="/images/eduardo-alvarez.webp"
          alt="Retrato de Eduardo Álvarez"
          width="768"
          height="1145"
          class="w-full aspect-[3/4] object-cover object-top rounded-panel border-hairline border"
          loading="eager"
        />
      </div>
    </section>

    <section>
      <h2 class="text-text-primary mb-6">En qué trabajo</h2>
      {/* Tarjetas del sistema en vez de `p-5 rounded-xl border bg-surface` a mano. */}
      <div class="gap-step-md grid sm:grid-cols-3">
        {
          [
            {
              titulo: "Liderar un equipo",
              texto: "Entiendo qué hay que construir y evalúo cómo: qué herramientas usamos y si nos sirven. Reviso que el código cumpla lo que acordamos y, si algo se cae, busco por qué para que no vuelva a pasar.",
            },
            {
              titulo: "Spec-Driven Development",
              texto: "Trabajo con agentes de IA sin perder el conocimiento de lo que hacen. Primero nos ponemos de acuerdo en qué hay que hacer y después se programa.",
            },
            {
              titulo: "Enseñar",
              texto: "Doy charlas y talleres, escribo en este blog y estoy armando cursos, muchos gratis. Antes de cada charla pregunto quién va a estar en la sala para adaptar lo que voy a mostrar.",
            },
          ].map(({ titulo, texto }) => (
            <Card>
              <CardHeader>
                <CardTitle>{titulo}</CardTitle>
                <CardDescription>{texto}</CardDescription>
              </CardHeader>
            </Card>
          ))
        }
      </div>
    </section>

    <!-- Ahora -->
    <section id="ahora">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="text-text-primary">Ahora</h2>
        <Text variant="meta" tone="muted" as="p">
          Actualizado: {formattedDate} · <a
            href="https://nownownow.com/about"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent hover:text-accent-hover transition-standard underline">¿Qué es esto?</a
          >
        </Text>
      </div>

      <div class="grid sm:grid-cols-3 gap-8">
        {
          nowCategories.map((category) => (
            <div>
              <Text as="h3" variant="eyebrow" tone="accent" className="mb-step-md">{category}</Text>
              <div class="gap-step-md flex flex-col">
                {nowByCategory[category].map((item: NowItem) => (
                  <div class="border-hairline pl-step-md hover:border-accent transition-standard border-l-2">
                    <Text variant="ui" as="p" className="mb-step-xs font-medium">{item.label}</Text>
                    {item.description && (
                      <Text variant="meta" tone="secondary" as="p">
                        {item.description}
                      </Text>
                    )}
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Experiencia -->
    <section>
      <h2 class="text-text-primary mb-8">Experiencia</h2>
      <div class="relative">
        <!-- Línea vertical -->
        <div class="absolute left-[7.5rem] top-0 bottom-0 w-px bg-border hidden sm:block"></div>

        <div class="space-y-8">
          {
            experience.map((item) => (
              <div class="flex flex-col sm:flex-row gap-2 sm:gap-8">
                <div class="sm:w-28 shrink-0 flex sm:justify-end items-start pt-0.5">
                  <Text variant="meta" tone={item.current ? "accent" : "muted"} as="span">
                    {item.date}
                  </Text>
                </div>

                <div class="hidden sm:flex items-start justify-center w-4 shrink-0 pt-1.5">
                  <div
                    class={`w-2 h-2 rounded-pill border-2 ${item.current ? "border-accent bg-accent" : "border-border bg-background"}`}
                  />
                </div>

                <div
                  class={`flex-1 pb-8 ${item.current ? "border-l-2 border-accent sm:border-none pl-4 sm:pl-0" : ""}`}
                >
                  <Text variant="ui" as="p" className="font-medium">{item.role}</Text>
                  <Text variant="label" tone="accent" as="p" className="mb-step-xs font-normal">{item.company}</Text>
                  <Text variant="meta" tone="secondary" as="p">{item.description}</Text>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-text-primary mb-6">Cómo pienso</h2>

      {/* One `Blockquote` per belief: the spec asks for 3–4 short statements, not a philosophy essay. */}
      <div class="space-y-6">
        <Blockquote>
          La IA es una herramienta. No le puedo culpar al martillo si la casa no quedó bien construida: soy yo el que
          maneja la herramienta, no al revés.
        </Blockquote>
        <Blockquote>
          No me gusta construir software sin entender lo que hace el agente. Por eso primero nos ponemos de acuerdo en
          qué hay que hacer, y después programamos.
        </Blockquote>
        <Blockquote>
          Un buen desarrollador no es el que escribe más rápido ni el que entrega sin bugs. Es el que entiende el
          problema y lo resuelve usando el código como herramienta, y ahora también la IA.
        </Blockquote>
        <Blockquote>El que no es capaz de escuchar y aprender llega a su techo más rápido.</Blockquote>
      </div>
    </section>

    <!-- Filosofía de vida -->
    <section>
      <h2 class="text-text-primary mb-6">Filosofía de vida</h2>
      <div class="space-y-6">
        <Blockquote>Si no estás dispuesto a darlo todo, no tienes derecho a intentarlo.</Blockquote>
        <Blockquote>No permitas que las cosas tomen más tiempo del que tienen que tomar.</Blockquote>
      </div>
    </section>

    <!-- Comunidad -->
    <section>
      <h2 class="text-text-primary mb-4">Comunidad</h2>
      <Text variant="body" tone="secondary">
        He dado charlas en conferencias técnicas, talleres en instituciones académicas y mentorías a decenas de
        ingenieros en distintos momentos de su carrera. Fui voluntario en <strong class="text-text-primary"
          >JSConf Chile</strong
        >, mentor en <strong class="text-text-primary">Laboratoria</strong> y en <strong class="text-text-primary"
          >TechSchool</strong
        >.
      </Text>
    </section>

    {/* La tarjeta y los tres botones son del sistema. El primario venía
        escrito a mano con `bg-accent text-background`, que en claro daba 4.39:1
        sobre crema — por debajo del mínimo. */}
    <Card className="p-step-xl">
      <h2 class="text-text-primary mb-3">¿Hablamos?</h2>
      <Text variant="body" tone="secondary" className="mb-step-xl">
        Si quieres que dé una charla o un taller, estás llevando Spec-Driven Development a tu equipo o solo quieres
        comentar algo que leíste aquí, escríbeme.
      </Text>
      <div class="gap-step-sm flex flex-wrap">
        <a href="mailto:soy@eduardoalvarez.dev" class={buttonVariants({ variant: "primary" })}>Escríbeme</a>
        <a
          href="https://www.linkedin.com/in/eduardoalvarezc"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: "secondary" })}
        >
          LinkedIn
        </a>
      </div>
    </Card>
  </div>
</Layout>
