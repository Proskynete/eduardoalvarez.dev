---
import Layout from "../../layouts/main/index.astro";
import { TalkCard } from "@eduardoalvarez/arrecife";

import settings from "../../settings";
import { talks } from "../../settings/talks";
import type { Talk } from "../../settings/talks";

export const prerender = true;

const visibleTalks = talks.filter((t: Talk) => t.show);

// Group by year descending
const byYear = visibleTalks.reduce<Record<number, Talk[]>>((acc, talk) => {
  const year = new Date(talk.date[0]).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(talk);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

const eventsSchema = {
  "@context": "https://schema.org",
  "@graph": visibleTalks.map((talk: Talk) => ({
    "@type": "Event",
    name: talk.title,
    startDate: new Date(talk.date[0]).toISOString(),
    ...(talk.description ? { description: talk.description } : {}),
    location: {
      "@type": "Place",
      name: talk.location.name,
      url: talk.location.url,
    },
    organizer: talk.organizations.map((org) => ({
      "@type": "Organization",
      name: org.name,
      url: org.url,
    })),
  })),
};

const seo = {
  title: "Charlas y talleres técnicos",
  description: "Charlas y talleres sobre liderazgo de ingeniería, arquitectura de plataformas y construcción con IA.",
  schema: eventsSchema,
};
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full">
    <!-- Page header -->
    <header class="mb-12">
      <p class="mb-[10px] font-mono text-[12.5px] text-text-muted">/charlas</p>
      <h1 class="mb-[14px] font-display text-[clamp(2.1rem,5vw,44px)] font-bold leading-[1.05] tracking-[-0.03em] text-text-primary">Charlas</h1>
      <p class="mb-3 max-w-[62ch] text-[17px] leading-relaxed text-text-secondary">
        Charlas y talleres sobre liderazgo de ingeniería, arquitectura de plataformas y construcción con IA.
      </p>
      <p class="max-w-[66ch] text-[15px] leading-[1.65] text-text-secondary">
        Participo regularmente en conferencias, meetups y workshops privados hablando sobre liderazgo técnico,
        plataformas internas, Developer Experience y el impacto real de la IA en equipos de ingeniería. Los formatos
        incluyen keynotes, charlas de 30-45 minutos, paneles y workshops intensivos presenciales o remotos.
      </p>
      <p class="text-text-secondary text-sm mb-4">
        Me encantaría participar en tu evento. Si quieres que hable, escríbeme a{" "}
        <a href="mailto:soy@eduardoalvarez.dev" class="text-accent underline">soy@eduardoalvarez.dev</a>
      </p>
      <p class="text-text-muted text-sm">
        {settings.authorInlineBio.text}{" "}
        <a href={settings.authorInlineBio.href} class="text-accent underline">{settings.authorInlineBio.cta}</a>
      </p>
    </header>

    {/*
      Antes era una lista con `divide-y` escrita a mano. `TalkCard` es la tarjeta
      del sistema para esto y ya trae el orden que tenía este bloque: organizador
      en antetítulo, título, resumen a dos líneas y, al pie, fecha y lugar.

      La tarjeta es un enlace, y las charlas no tienen página propia, así que
      apunta al material: las slides si las hay, si no el repo, y si tampoco al
      sitio del evento. Los enlaces sueltos de «Slides ↗ / Repo ↗» desaparecen
      porque `TalkCard` no tiene ranura para ellos — queda anotado para arrecife.
    */}
    {years.map((year: number) => (
      <section class="mb-14">
        <h2 class="text-sm font-medium text-text-muted uppercase tracking-widest mb-6 flex items-center gap-3">
          {year}
          <span class="flex-1 h-px bg-border"></span>
        </h2>

        <div class="gap-step-md grid sm:grid-cols-2">
          {byYear[year].map((talk: Talk) => (
            <TalkCard
              href={talk.options?.presentation ?? talk.options?.repo ?? talk.location.url}
              target="_blank"
              rel="noopener noreferrer"
              title={talk.title}
              event={talk.organizations[0]?.name ?? talk.location.name}
              date={new Date(talk.date[0]).toLocaleDateString("es-CL", { month: "long", day: "numeric" })}
              dateTime={talk.date[0]}
              location={talk.location.name}
              description={talk.description}
              className="h-full"
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
