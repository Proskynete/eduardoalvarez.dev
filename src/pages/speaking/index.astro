---
import { PageHeader, Separator, Text } from "@eduardoalvarez/arrecife";

import Layout from "../../layouts/main/index.astro";
import TalkCard from "../../components/talk-card/index";

import { talks } from "../../settings/talks";
import type { Talk } from "../../settings/talks";

export const prerender = true;

const visibleTalks = talks.filter((t: Talk) => t.show);

// Group by year descending
const byYear = visibleTalks.reduce<Record<number, Talk[]>>((acc, talk) => {
  const year = new Date(talk.date[0]).getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(talk);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

const eventsSchema = {
  "@context": "https://schema.org",
  "@graph": visibleTalks.map((talk: Talk) => ({
    "@type": "Event",
    name: talk.title,
    startDate: new Date(talk.date[0]).toISOString(),
    ...(talk.description ? { description: talk.description } : {}),
    location: {
      "@type": "Place",
      name: talk.location.name,
      url: talk.location.url,
    },
    organizer: talk.organizations.map((org) => ({
      "@type": "Organization",
      name: org.name,
      url: org.url,
    })),
  })),
};

const seo = {
  title: "Charlas y talleres técnicos",
  description: "Charlas y talleres sobre liderazgo de ingeniería, arquitectura de plataformas y construcción con IA.",
  schema: eventsSchema,
};
---

<Layout seo={seo}>
  <div class="mx-auto max-w-full">
    {/*
      `PageHeader` de la librería. Lo que había era una copia a mano de la misma
      cabecera que /articles y /about ya pintaban con el componente, y traía
      cinco valores arbitrarios —`text-[12.5px]`, `clamp(2.1rem,5vw,44px)`,
      `max-w-[62ch]`, `text-[17px]`, `leading-[1.05]`— que el sistema publica
      como tokens. Tres páginas la copiaban; las tres ya habían derivado.
    */}
    <PageHeader
      eyebrow="/charlas"
      title="Charlas"
      description="Charlas y talleres sobre liderazgo de ingeniería, arquitectura de plataformas y construcción con IA."
    />

    <div class="gap-step-sm mb-step-xl flex flex-col">
      <Text variant="ui" tone="secondary">
        Participo regularmente en conferencias, meetups y workshops privados hablando sobre liderazgo técnico,
        plataformas internas, Developer Experience y el impacto real de la IA en equipos de ingeniería. Los formatos
        incluyen keynotes, charlas de 30-45 minutos, paneles y workshops intensivos presenciales o remotos.
      </Text>
      <Text variant="label" tone="secondary" as="p" className="font-normal">
        Me encantaría participar en tu evento. Si quieres que hable, escríbeme a{" "}
        <a href="mailto:soy@eduardoalvarez.dev" class="text-accent underline">soy@eduardoalvarez.dev</a>
      </Text>
    </div>

    {/*
      `TalkCard` from the library. 0.6.0 added `resources`, so the slides and
      repo links are back: before it the card had nowhere to put them, became a
      link to whichever one existed, and the rest vanished. With resources
      present the library stops making the card a link — several destinations
      cannot be one.
    */}
    {years.map((year: number) => (
      <section class="mb-14">
        {/* `Separator` en vez del `span` de un píxel: la línea que divide
            contenido es `hairline`, no `border` — son dos tokens distintos y la
            regla la fija la librería. */}
        <div class="mb-step-md gap-step-sm flex items-center">
          <Text as="h2" variant="eyebrow" tone="muted">{year}</Text>
          <Separator className="flex-1" />
        </div>

        <div class="gap-step-md grid sm:grid-cols-2">
          {byYear[year].map((talk: Talk) => (
            <TalkCard
              title={talk.title}
              event={talk.organizations[0]?.name ?? talk.location.name}
              date={new Date(talk.date[0]).toLocaleDateString("es-CL", { month: "long", day: "numeric" })}
              dateTime={talk.date[0]}
              location={talk.location.name}
              description={talk.description}
              resources={[
                ...(talk.options?.presentation ? [{ label: "Slides", url: talk.options.presentation }] : []),
                ...(talk.options?.repo ? [{ label: "Repo", url: talk.options.repo }] : []),
                ...(talk.options?.resources ?? []).map((r) => ({ label: r.label, url: r.url })),
              ]}
            />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
